theorem deriv_f_QIII_0_neg_Icc_eighth (β : ℝ) (hβ : β = β₀ ∨ β = 2⁻¹) (y : ℝ)
    (hy : y ∈ Icc (8⁻¹ : ℝ) 2⁻¹) : deriv (f_QIII_0 β) y < 0 := by
