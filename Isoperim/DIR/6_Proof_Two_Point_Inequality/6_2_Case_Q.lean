        (2 * Q β (y - h / 2) - Q β (y - h))) =
      h ^ (β⁻¹ - 1) * (2 * Q β (y - h / 2) - Q β (y - h))
        - (deriv (Q β) (y - h) - deriv (Q β) (y - h / 2)) * (h ^ β⁻¹ + Q β y ^ β⁻¹) := by
