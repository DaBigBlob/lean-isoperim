/-!
# [DIR] §6.2 Case Q: auxiliary lemmas

This file was automatically generated by Claude.

Auxiliary lemmas for `6_2_Case_Q.lean`.

## The two-point inequality for $L_\beta$ ([BIM23, Lemma 2.2])

[DIR] cites $G^1_\beta[L_\beta](x,y)\ge0$ for $0\le x\le y\le\frac12$ from D. Beltran,
P. Ivanisvili, J. Madrid, *On sharp isoperimetric inequalities on the hypercube*,
arXiv:2303.06738 (Trans. Amer. Math. Soc.), Lemma 2.2. We follow the proof given there: with
$x=ty$ and $a=\log_2\frac1y$ the inequality reads
$$(a+(1-t)^{1/\beta})^\beta+t(a+\log_2\tfrac1t)^\beta\ge(1+t)(a+\log_2\tfrac2{1+t})^\beta;$$
* Step 1: replace $(1-t)^{1/\beta}$ by $(1-t)^2$ and use the power mean inequality to reduce to
  $\beta=\frac12$;
* Step 2: $a\mapsto(\mathbb E\sqrt{a+X})^2-a$ is non-decreasing, which reduces to $a=1$
  ($y=\frac12$);
* Step 3: the inequality
  $\sqrt{1+s^2}+(1-s)\sqrt{1-\log_2(1-s)}\ge(2-s)\sqrt{1+\log_2\frac2{2-s}}$, $s=1-t$, by the
  bounds $-\log(1-s)\ge s+\frac{s^2}2$, $\log\frac2{2-s}\le\frac s2+(\log2-\frac12)s^2$ and an
  explicit polynomial.

No new notation is introduced.
-/

@[expose] public section

namespace Auto.DIR

open Real Set Filter Topology

/-! ### Step 3: logarithmic bounds and the inequality at $y=\frac12$ -/

/-- [BIM23], proof of Lemma 2.2: $-\log(1-s)\ge s+\frac{s^2}2$ for $0\le s<1$. -/
theorem neg_log_one_sub_ge {s : ℝ} (hs0 : 0 ≤ s) (hs1 : s < 1) :
    s + s ^ 2 / 2 ≤ -log (1 - s) := by
  have h := hasSum_pow_div_log_of_abs_lt_one (x := s) (by rw [abs_of_nonneg hs0]; exact hs1)
  have := sum_le_hasSum (Finset.range 2) (fun i _ ↦ by positivity) h
  simp only [Finset.sum_range_succ, Finset.sum_range_zero] at this
  norm_num at this
  linarith

/-- [BIM23], proof of Lemma 2.2: $\log\frac2{2-s}\le\frac s2+(\log2-\frac12)s^2$ for
$s\in[0,1]$ (the function $g(s)=\frac s2+(\log2-\frac12)s^2-\log\frac2{2-s}$ vanishes at $0$
and $1$, and $g'(s)=\frac{s((8\log2-5)-(4\log2-2)s)}{2(2-s)}$ changes sign once). -/
theorem log_two_div_two_sub_le {s : ℝ} (hs : s ∈ Icc (0 : ℝ) 1) :
    log (2 / (2 - s)) ≤ s / 2 + (log 2 - 2⁻¹) * s ^ 2 := by
  have hl1 := log_two_gt_d9
  have hl2 := log_two_lt_d9
  set g : ℝ → ℝ := fun u ↦ u / 2 + (log 2 - 2⁻¹) * u ^ 2 - log 2 + log (2 - u) with hg
  have hD : ∀ u, u < 2 → HasDerivAt g (u * ((8 * log 2 - 5) - (4 * log 2 - 2) * u) /
      (2 * (2 - u))) u := fun u hu ↦ by
    have h := ((((hasDerivAt_id' u).div_const 2).add ((hasDerivAt_pow 2 u).const_mul
      (log 2 - 2⁻¹))).sub_const (log 2)).add (((hasDerivAt_id' u).const_sub 2).log
        (by linarith))
    refine h.congr_deriv ?_
    have : (2 : ℝ) - u ≠ 0 := by linarith
    field_simp
    ring
  have hc : ContinuousOn g (Icc 0 1) := fun u hu ↦
    (hD u (by linarith [hu.2])).continuousAt.continuousWithinAt
  have hg0 : g 0 = 0 := by simp [hg]
  have hg1 : g 1 = 0 := by norm_num [hg]
  have hk : 0 < 4 * log 2 - 2 := by linarith
  set s₀ := (8 * log 2 - 5) / (4 * log 2 - 2) with hs₀
  have hs₀0 : 0 < s₀ := div_pos (by linarith) hk
  have hs₀1 : s₀ < 1 := by rw [hs₀, div_lt_one hk]; linarith
  have hgs : 0 ≤ g s := by
    rcases le_total s s₀ with h | h
    · have hm : MonotoneOn g (Icc 0 s₀) := monotoneOn_of_deriv_nonneg (convex_Icc 0 s₀)
        (hc.mono (Icc_subset_Icc le_rfl hs₀1.le))
        (fun u hu ↦ by
          rw [interior_Icc] at hu
          exact (hD u (by linarith [hu.2])).differentiableAt.differentiableWithinAt)
        fun u hu ↦ by
          rw [interior_Icc] at hu
          rw [(hD u (by linarith [hu.2])).deriv]
          have h1 : 0 ≤ (8 * log 2 - 5) - (4 * log 2 - 2) * u := by
            have : (4 * log 2 - 2) * u ≤ (4 * log 2 - 2) * s₀ :=
              mul_le_mul_of_nonneg_left hu.2.le hk.le
            rw [hs₀, mul_div_cancel₀ _ hk.ne'] at this; linarith
          exact div_nonneg (mul_nonneg hu.1.le h1) (by linarith [hu.2])
      have := hm ⟨le_rfl, hs₀0.le⟩ ⟨hs.1, h⟩ hs.1
      rwa [hg0] at this
    · have ha : AntitoneOn g (Icc s₀ 1) := antitoneOn_of_deriv_nonpos (convex_Icc s₀ 1)
        (hc.mono (Icc_subset_Icc hs₀0.le le_rfl))
        (fun u hu ↦ by
          rw [interior_Icc] at hu
          exact (hD u (by linarith [hu.2])).differentiableAt.differentiableWithinAt)
        fun u hu ↦ by
          rw [interior_Icc] at hu
          rw [(hD u (by linarith [hu.2])).deriv]
          have h1 : (8 * log 2 - 5) - (4 * log 2 - 2) * u ≤ 0 := by
            have : (4 * log 2 - 2) * s₀ ≤ (4 * log 2 - 2) * u :=
              mul_le_mul_of_nonneg_left hu.1.le hk.le
            rw [hs₀, mul_div_cancel₀ _ hk.ne'] at this; linarith
          exact div_nonpos_of_nonpos_of_nonneg
            (mul_nonpos_of_nonneg_of_nonpos (hs₀0.trans hu.1).le h1) (by linarith [hu.2])
      have := ha ⟨h, hs.2⟩ ⟨hs₀1.le, le_rfl⟩ hs.2
      rwa [hg1] at this
  have : log (2 / (2 - s)) = log 2 - log (2 - s) :=
    log_div (by norm_num) (by linarith [hs.2])
  simp only [hg] at hgs
  linarith

/-- [BIM23], proof of Lemma 2.2: the polynomial
$v(s)=4(\log2-1)^2s^4+12(1-\log2)(2\log2-1)s^3-(17-18\log2)(2\log2-1)s^2
-(12-24\log2+16(\log2)^2)s+32(\log2)^2-32\log2+4$ is negative on $[0,1]$. -/
theorem bim_poly_neg {s : ℝ} (hs : s ∈ Icc (0 : ℝ) 1) :
    4 * (log 2 - 1) ^ 2 * s ^ 4 + 12 * (1 - log 2) * (2 * log 2 - 1) * s ^ 3 -
      (17 - 18 * log 2) * (2 * log 2 - 1) * s ^ 2 - (12 - 24 * log 2 + 16 * (log 2) ^ 2) * s +
      32 * (log 2) ^ 2 - 32 * log 2 + 4 < 0 := by
  have hl1 := log_two_gt_d9
  have hl2 := log_two_lt_d9
  have hs4 : s ^ 4 ≤ 1 := pow_le_one₀ hs.1 hs.2
  have hs3 : s ^ 3 ≤ 1 := pow_le_one₀ hs.1 hs.2
  have hc4 : 0 ≤ 4 * (log 2 - 1) ^ 2 := by positivity
  have hc4' : 4 * (log 2 - 1) ^ 2 ≤ 0.38 := by nlinarith
  have hc3 : 0 ≤ 12 * (1 - log 2) * (2 * log 2 - 1) := by
    have : (0 : ℝ) ≤ 1 - log 2 := by linarith
    have : (0 : ℝ) ≤ 2 * log 2 - 1 := by linarith
    positivity
  have hc3' : 12 * (1 - log 2) * (2 * log 2 - 1) ≤ 1.43 := by nlinarith
  have hc2 : 0 ≤ (17 - 18 * log 2) * (2 * log 2 - 1) := by
    have : (0 : ℝ) ≤ 17 - 18 * log 2 := by linarith
    have : (0 : ℝ) ≤ 2 * log 2 - 1 := by linarith
    positivity
  have hc1 : 0 ≤ 12 - 24 * log 2 + 16 * (log 2) ^ 2 := by nlinarith
  have hc0 : 32 * (log 2) ^ 2 - 32 * log 2 + 4 < -2.8 := by nlinarith
  nlinarith [mul_le_mul_of_nonneg_left hs4 hc4, mul_le_mul_of_nonneg_left hs3 hc3,
    mul_nonneg hc2 (sq_nonneg s), mul_nonneg hc1 hs.1]

/-- [BIM23], (2.6): for $s\in[0,1)$,
$(2-s)\sqrt{1+\log_2\frac2{2-s}}\le\sqrt{1+s^2}+(1-s)\sqrt{1-\log_2(1-s)}$. -/
theorem bim_core {s : ℝ} (hs0 : 0 ≤ s) (hs1 : s < 1) :
    (2 - s) * √(1 + log₂ (2 / (2 - s))) ≤ √(1 + s ^ 2) + (1 - s) * √(1 - log₂ (1 - s)) := by
  have hl1 := log_two_gt_d9
  have hl2 := log_two_lt_d9
  have hl : 0 < log 2 := by linarith
  set P := 1 + (s + s ^ 2 / 2) / log 2 with hP
  set R := 1 + s / (2 * log 2) + (1 - 1 / (2 * log 2)) * s ^ 2 with hR
  have hP0 : 0 ≤ P := by rw [hP]; positivity
  have hPle : P ≤ 1 - log₂ (1 - s) := by
    have h := div_le_div_of_nonneg_right (neg_log_one_sub_ge hs0 hs1) hl.le
    rw [neg_div] at h
    rw [hP, logb]; linarith
  have hRge : 1 + log₂ (2 / (2 - s)) ≤ R := by
    have h := log_two_div_two_sub_le ⟨hs0, hs1.le⟩
    have h' : log₂ (2 / (2 - s)) ≤ (s / 2 + (log 2 - 2⁻¹) * s ^ 2) / log 2 := by
      rw [logb]; exact div_le_div_of_nonneg_right h hl.le
    have e : (s / 2 + (log 2 - 2⁻¹) * s ^ 2) / log 2 =
        s / (2 * log 2) + (1 - 1 / (2 * log 2)) * s ^ 2 := by
      field_simp
    rw [hR]; linarith
  have hR0 : 0 ≤ R := by
    have h1 : 0 ≤ 1 - 1 / (2 * log 2) := by
      rw [sub_nonneg, div_le_one (by positivity)]; linarith
    have := mul_nonneg h1 (sq_nonneg s)
    have : 0 ≤ s / (2 * log 2) := by positivity
    rw [hR]; linarith
  have h1s : 0 ≤ 1 - s := by linarith
  have hA0 : (0 : ℝ) ≤ 1 + s ^ 2 := by positivity
  have hT : (2 - s) * √R ≤ √(1 + s ^ 2) + (1 - s) * √P := by
    have hM0 : 0 ≤ 2 * (1 - s) * √(1 + s ^ 2) * √P := by positivity
    have hW : (2 - s) ^ 2 * R - (1 + s ^ 2) - (1 - s) ^ 2 * P ≤
        2 * (1 - s) * √(1 + s ^ 2) * √P := by
      rcases le_or_gt ((2 - s) ^ 2 * R - (1 + s ^ 2) - (1 - s) ^ 2 * P) 0 with hW | hW
      · linarith
      · refine (pow_le_pow_iff_left₀ hW.le hM0 two_ne_zero).1 ?_
        have hsq : (2 * (1 - s) * √(1 + s ^ 2) * √P) ^ 2 =
            4 * (1 - s) ^ 2 * (1 + s ^ 2) * P := by
          rw [mul_pow, mul_pow, mul_pow, sq_sqrt hA0, sq_sqrt hP0]; ring
        rw [hsq]
        have hv := bim_poly_neg ⟨hs0, hs1.le⟩
        have key : 4 * (1 - s) ^ 2 * (1 + s ^ 2) * P -
            ((2 - s) ^ 2 * R - (1 + s ^ 2) - (1 - s) ^ 2 * P) ^ 2 =
            -(s ^ 2 * (1 - s) ^ 2 / (4 * (log 2) ^ 2)) *
              (4 * (log 2 - 1) ^ 2 * s ^ 4 + 12 * (1 - log 2) * (2 * log 2 - 1) * s ^ 3 -
                (17 - 18 * log 2) * (2 * log 2 - 1) * s ^ 2 -
                (12 - 24 * log 2 + 16 * (log 2) ^ 2) * s + 32 * (log 2) ^ 2 - 32 * log 2 + 4) := by
          rw [hP, hR]; field_simp; ring
        have hk : 0 ≤ s ^ 2 * (1 - s) ^ 2 / (4 * (log 2) ^ 2) := by positivity
        nlinarith [mul_nonneg hk (neg_nonneg.2 hv.le)]
    refine (pow_le_pow_iff_left₀ (mul_nonneg (by linarith) (sqrt_nonneg _))
      (add_nonneg (sqrt_nonneg _) (mul_nonneg h1s (sqrt_nonneg _))) two_ne_zero).1 ?_
    have e1 : ((2 - s) * √R) ^ 2 = (2 - s) ^ 2 * R := by rw [mul_pow, sq_sqrt hR0]
    have e2 : (√(1 + s ^ 2) + (1 - s) * √P) ^ 2 =
        (1 + s ^ 2) + 2 * (1 - s) * √(1 + s ^ 2) * √P + (1 - s) ^ 2 * P := by
      rw [add_sq, mul_pow, sq_sqrt hP0, sq_sqrt hA0]; ring
    rw [e1, e2]; linarith
  calc (2 - s) * √(1 + log₂ (2 / (2 - s))) ≤ (2 - s) * √R :=
        mul_le_mul_of_nonneg_left (sqrt_le_sqrt hRge) (by linarith)
    _ ≤ √(1 + s ^ 2) + (1 - s) * √P := hT
    _ ≤ √(1 + s ^ 2) + (1 - s) * √(1 - log₂ (1 - s)) :=
        add_le_add le_rfl (mul_le_mul_of_nonneg_left (sqrt_le_sqrt hPle) h1s)

/-! ### Step 2: reduction to $y=\frac12$ -/

/-- [BIM23], proof of Lemma 2.2, Step 2: $a\mapsto(p\sqrt{a+X_1}+q\sqrt{a+X_2})^2-a$ is
non-decreasing; here in the form needed, comparing $a\ge1$ with $a=1$ (for $p,q\ge0$, $p+q=1$,
$X_1,X_2\ge0$). -/
theorem bim_step2 {p q X₁ X₂ a : ℝ} (hp : 0 ≤ p) (hq : 0 ≤ q) (hpq : p + q = 1)
    (hX₁ : 0 ≤ X₁) (hX₂ : 0 ≤ X₂) (ha : 1 ≤ a) :
    (p * √(1 + X₁) + q * √(1 + X₂)) ^ 2 - 1 ≤ (p * √(a + X₁) + q * √(a + X₂)) ^ 2 - a := by
  have hu₁ : √(1 + X₁) ^ 2 = 1 + X₁ := sq_sqrt (by linarith)
  have hu₂ : √(1 + X₂) ^ 2 = 1 + X₂ := sq_sqrt (by linarith)
  have hw₁ : √(a + X₁) ^ 2 = a + X₁ := sq_sqrt (by linarith)
  have hw₂ : √(a + X₂) ^ 2 = a + X₂ := sq_sqrt (by linarith)
  set u₁ := √(1 + X₁)
  set u₂ := √(1 + X₂)
  set w₁ := √(a + X₁)
  set w₂ := √(a + X₂)
  have hd : 0 ≤ a - 1 := by linarith
  have hw : u₁ * u₂ + (a - 1) ≤ w₁ * w₂ := by
    refine (pow_le_pow_iff_left₀ (by positivity) (by positivity) two_ne_zero).1 ?_
    have h2 : 2 * (u₁ * u₂) ≤ u₁ ^ 2 + u₂ ^ 2 := by nlinarith [sq_nonneg (u₁ - u₂)]
    calc (u₁ * u₂ + (a - 1)) ^ 2 = u₁ ^ 2 * u₂ ^ 2 + (a - 1) * (2 * (u₁ * u₂)) + (a - 1) ^ 2 := by
          ring
      _ ≤ u₁ ^ 2 * u₂ ^ 2 + (a - 1) * (u₁ ^ 2 + u₂ ^ 2) + (a - 1) ^ 2 := by
          nlinarith [mul_le_mul_of_nonneg_left h2 hd]
      _ = (w₁ * w₂) ^ 2 := by rw [mul_pow, hw₁, hw₂, hu₁, hu₂]; ring
  have hq' : q = 1 - p := by linarith
  calc (p * u₁ + q * u₂) ^ 2 - 1 = p ^ 2 * u₁ ^ 2 + q ^ 2 * u₂ ^ 2 + 2 * (p * q) * (u₁ * u₂) - 1 :=
        by ring
    _ ≤ p ^ 2 * u₁ ^ 2 + q ^ 2 * u₂ ^ 2 + 2 * (p * q) * (w₁ * w₂ - (a - 1)) - 1 := by
        nlinarith [mul_le_mul_of_nonneg_left hw (mul_nonneg hp hq)]
    _ = p ^ 2 * w₁ ^ 2 + q ^ 2 * w₂ ^ 2 + 2 * (p * q) * (w₁ * w₂) - a := by
        rw [hu₁, hu₂, hw₁, hw₂, hq']; ring
    _ = (p * w₁ + q * w₂) ^ 2 - a := by ring

/-! ### Step 1 and the two-point inequality -/

/-- [BIM23, Lemma 2.2] in the variables $t=\frac xy\in[0,1]$ and $a=\log_2\frac1y\ge1$
($\beta\in[\frac12,1]$):
$(1+t)(a+\log_2\frac2{1+t})^\beta\le(a+(1-t)^{1/\beta})^\beta+t(a+\log_2\frac1t)^\beta$. -/
theorem bim_reduced {β t a : ℝ} (hβ : β ∈ Icc (2⁻¹ : ℝ) 1) (ht0 : 0 ≤ t) (ht1 : t ≤ 1)
    (ha : 1 ≤ a) :
    (1 + t) * (a + log₂ (2 / (1 + t))) ^ β ≤ (a + (1 - t) ^ β⁻¹) ^ β + t * (a + log₂ t⁻¹) ^ β := by
  have hβ0 : 0 < β := by linarith [hβ.1]
  rcases eq_or_lt_of_le ht0 with rfl | ht0
  · simp
  set ℓ := log₂ t⁻¹ with hℓdef
  set c := log₂ (2 / (1 + t)) with hcdef
  have hℓ : 0 ≤ ℓ := logb_nonneg one_lt_two ((one_le_inv₀ ht0).2 ht1)
  have hc : 0 ≤ c := logb_nonneg one_lt_two (by rw [le_div_iff₀ (by linarith)]; linarith)
  set p := 1 / (1 + t) with hpdef
  set q := t / (1 + t) with hqdef
  have hp : 0 ≤ p := by positivity
  have hq : 0 ≤ q := by positivity
  have hpq : p + q = 1 := by rw [hpdef, hqdef]; field_simp
  have hcore : √(1 + c) ≤ p * √(1 + (1 - t) ^ 2) + q * √(1 + ℓ) := by
    have h := bim_core (s := 1 - t) (by linarith) (by linarith)
    rw [show (2 : ℝ) - (1 - t) = 1 + t by ring, show (1 : ℝ) - (1 - t) = t by ring] at h
    have e : 1 - log₂ t = 1 + ℓ := by rw [hℓdef, logb_inv]; ring
    rw [e] at h
    calc √(1 + c) = (1 + t) * √(1 + c) / (1 + t) := by field_simp
      _ ≤ (√(1 + (1 - t) ^ 2) + t * √(1 + ℓ)) / (1 + t) :=
          div_le_div_of_nonneg_right h (by linarith)
      _ = p * √(1 + (1 - t) ^ 2) + q * √(1 + ℓ) := by rw [hpdef, hqdef]; ring
  have h2 := bim_step2 hp hq hpq (sq_nonneg (1 - t)) hℓ ha
  set m := p * √(a + (1 - t) ^ 2) + q * √(a + ℓ) with hmdef
  have hm0 : 0 ≤ m := by positivity
  have hsq : a + c ≤ m ^ 2 := by
    have : 1 + c ≤ (p * √(1 + (1 - t) ^ 2) + q * √(1 + ℓ)) ^ 2 := by
      have := pow_le_pow_left₀ (sqrt_nonneg _) hcore 2
      rwa [sq_sqrt (by linarith)] at this
    linarith
  have hJ : m ^ (2 * β) ≤ p * √(a + (1 - t) ^ 2) ^ (2 * β) + q * √(a + ℓ) ^ (2 * β) := by
    have := (convexOn_rpow (by linarith [hβ.1] : (1 : ℝ) ≤ 2 * β)).2
      (sqrt_nonneg _ : √(a + (1 - t) ^ 2) ∈ Ici 0) (sqrt_nonneg _ : √(a + ℓ) ∈ Ici 0) hp hq hpq
    simpa only [smul_eq_mul] using this
  have hsr : ∀ z : ℝ, 0 ≤ z → √z ^ (2 * β) = z ^ β := fun z hz ↦ by
    rw [sqrt_eq_rpow, ← rpow_mul hz]; ring_nf
  have hmr : m ^ (2 * β) = (m ^ 2) ^ β := by
    rw [← rpow_natCast, ← rpow_mul hm0]; norm_num
  have h3 : (a + (1 - t) ^ 2) ^ β ≤ (a + (1 - t) ^ β⁻¹) ^ β := by
    refine rpow_le_rpow (by positivity) ?_ hβ0.le
    have hb : β⁻¹ ≤ 2 := by
      rw [inv_le_comm₀ hβ0 two_pos]; linarith [hβ.1]
    have := rpow_le_rpow_of_exponent_ge' (by linarith : (0 : ℝ) ≤ 1 - t) (by linarith)
      (by positivity) hb
    rw [rpow_two] at this; linarith
  have key : (a + c) ^ β ≤ p * (a + (1 - t) ^ β⁻¹) ^ β + q * (a + ℓ) ^ β :=
    calc (a + c) ^ β ≤ (m ^ 2) ^ β := rpow_le_rpow (by linarith) hsq hβ0.le
      _ = m ^ (2 * β) := hmr.symm
      _ ≤ p * √(a + (1 - t) ^ 2) ^ (2 * β) + q * √(a + ℓ) ^ (2 * β) := hJ
      _ = p * (a + (1 - t) ^ 2) ^ β + q * (a + ℓ) ^ β := by
          rw [hsr _ (by positivity), hsr _ (by positivity)]
      _ ≤ p * (a + (1 - t) ^ β⁻¹) ^ β + q * (a + ℓ) ^ β :=
          add_le_add (mul_le_mul_of_nonneg_left h3 hp) le_rfl
  calc (1 + t) * (a + c) ^ β ≤ (1 + t) * (p * (a + (1 - t) ^ β⁻¹) ^ β + q * (a + ℓ) ^ β) :=
        mul_le_mul_of_nonneg_left key (by linarith)
    _ = (a + (1 - t) ^ β⁻¹) ^ β + t * (a + ℓ) ^ β := by
        rw [hpdef, hqdef]; field_simp

/-- **[BIM23, Lemma 2.2]**: $G^1_\beta[L_\beta](x,y)\ge0$ for $\beta\in[\frac12,1]$ and
$0\le x\le y\le\frac12$. -/
theorem G₁_L_nonneg {β : ℝ} (hβ : β ∈ Icc (2⁻¹ : ℝ) 1) {x y : ℝ} (hx : 0 ≤ x) (hxy : x ≤ y)
    (hy : y ≤ 2⁻¹) : G₁ β (L β) x y ≥ 0 := by
  have hβ0 : 0 < β := by linarith [hβ.1]
  have hβne : β ≠ 0 := hβ0.ne'
  rcases eq_or_lt_of_le (hx.trans hxy) with hy0 | hy0
  · have hx0 : x = 0 := le_antisymm (hxy.trans hy0.symm.le) hx
    subst hx0; rw [← hy0]
    simp [G₁, L, zero_rpow (inv_ne_zero hβne), zero_rpow hβne]
  set t := x / y with htdef
  set a := log₂ y⁻¹ with hadef
  have hxt : x = t * y := by rw [htdef]; field_simp
  have ht0 : 0 ≤ t := div_nonneg hx hy0.le
  have ht1 : t ≤ 1 := (div_le_one hy0).2 hxy
  have ha : 1 ≤ a := by
    rw [hadef, le_logb_iff_rpow_le one_lt_two (inv_pos.2 hy0), rpow_one, le_inv_comm₀ two_pos hy0]
    exact hy
  have ha0 : 0 ≤ a := by linarith
  have hyβ : (y ^ β⁻¹) ^ β = y := rpow_inv_rpow hy0.le hβne
  have hfirst : ((y - x) ^ β⁻¹ + L β y ^ β⁻¹) ^ β = y * (a + (1 - t) ^ β⁻¹) ^ β := by
    have h1t : 0 ≤ 1 - t := by linarith
    rw [show y - x = y * (1 - t) by rw [hxt]; ring, show L β y = y * a ^ β from rfl,
      mul_rpow hy0.le h1t, mul_rpow hy0.le (rpow_nonneg ha0 _), rpow_rpow_inv ha0 hβne,
      ← mul_add, mul_rpow (rpow_nonneg hy0.le _) (by positivity), hyβ, add_comm]
  have hLx : L β x = t * y * (a + log₂ t⁻¹) ^ β := by
    rcases eq_or_lt_of_le ht0 with ht | ht
    · rw [← ht, zero_mul] at hxt; rw [hxt, ← ht]; simp [L]
    · rw [show L β x = x * (log₂ x⁻¹) ^ β from rfl, hxt, mul_inv,
        logb_mul (inv_ne_zero ht.ne') (inv_ne_zero hy0.ne'), add_comm]
  have hLm : L β ((x + y) / 2) = (1 + t) * y / 2 * (a + log₂ (2 / (1 + t))) ^ β := by
    have h1t : (0 : ℝ) < 1 + t := by linarith
    rw [show (x + y) / 2 = (1 + t) * y / 2 by rw [hxt]; ring,
      show L β ((1 + t) * y / 2) = (1 + t) * y / 2 * (log₂ ((1 + t) * y / 2)⁻¹) ^ β from rfl,
      show ((1 + t) * y / 2)⁻¹ = 2 / (1 + t) * y⁻¹ by field_simp,
      logb_mul (by positivity) (inv_ne_zero hy0.ne'), add_comm (log₂ (2 / (1 + t)))]
  have hb := bim_reduced hβ ht0 ht1 ha
  rw [G₁, hfirst, hLx, hLm]
  nlinarith [mul_le_mul_of_nonneg_left hb hy0.le]

/-! ### Case Q: the parameters and the two-point functional -/

/-- $\log_2\frac32\ge\frac{11}{20}$. -/
theorem logb_three_halves_ge : (11 / 20 : ℝ) ≤ log₂ (3 / 2) := by
  have hl : 0 < log 2 := log_pos one_lt_two
  rw [logb, le_div_iff₀ hl]
  have : log ((2 : ℝ) ^ 11) ≤ log ((3 / 2) ^ 20) := log_le_log (by positivity) (by norm_num)
  rw [log_pow, log_pow] at this; push_cast at this; linarith

/-- The two values $\beta\in\{\frac12,\beta_0\}$ of Case $Q$ lie in $[\frac12,\log_2\frac32)$. -/
theorem mem_Ico_of_caseQ {β : ℝ} (hβ : β = 2⁻¹ ∨ β = β₀) : β ∈ Ico (2⁻¹ : ℝ) (log₂ (3 / 2)) := by
  have h := logb_three_halves_ge
  rcases hβ with rfl | rfl
  · exact ⟨le_rfl, by linarith⟩
  · rw [β₀]; exact ⟨by norm_num, by linarith⟩

/-- The two values $\beta\in\{\frac12,\beta_0\}$ of Case $Q$ lie in $[\frac12,1]$. -/
theorem mem_Icc_one_of_caseQ {β : ℝ} (hβ : β = 2⁻¹ ∨ β = β₀) : β ∈ Icc (2⁻¹ : ℝ) 1 :=
  ⟨(mem_Ico_of_caseQ hβ).1, (mem_Ico_of_caseQ hβ).2.le.trans
    (logb_three_halves_mem.2.trans (by norm_num))⟩

/-- The functional $\mathcal L(x,y,u,v)=\frac12(((y-x)^{1/\beta}+\max(v,0)^{1/\beta})^\beta+u)$
of (5.1) for $G^1_\beta$ (the cut-off $\max(v,0)$ only matters for $v<0$). -/
noncomputable def 𝓛G₁ (β x y u v : ℝ) : ℝ := (((y - x) ^ β⁻¹ + max v 0 ^ β⁻¹) ^ β + u) / 2

/-- $\mathcal L$ of `𝓛G₁` is monotone increasing in $u,v$. -/
theorem 𝓛G₁_mono {β : ℝ} (hβ : 0 < β) : IsMonotoneTwoPoint (𝓛G₁ β) 0 2⁻¹ := by
  intro x y hx hxy hy u u' v v' hu hv
  have h1 : max v 0 ^ β⁻¹ ≤ max v' 0 ^ β⁻¹ :=
    rpow_le_rpow (le_max_right _ _) (max_le_max hv le_rfl) (inv_nonneg.2 hβ.le)
  have h0 : 0 ≤ (y - x) ^ β⁻¹ + max v 0 ^ β⁻¹ :=
    add_nonneg (rpow_nonneg (by linarith) _) (rpow_nonneg (le_max_right _ _) _)
  have h2 := rpow_le_rpow h0 (add_le_add le_rfl h1) hβ.le
  unfold 𝓛G₁; linarith

/-- $G^1_\beta[B](x,y)\ge0$ is (5.1) for `𝓛G₁` (if $B(y)\ge0$). -/
theorem G₁_nonneg_iff {β : ℝ} {B : ℝ → ℝ} {x y : ℝ} (hB : 0 ≤ B y) :
    G₁ β B x y ≥ 0 ↔ 𝓛G₁ β x y (B x) (B y) ≥ B ((x + y) / 2) := by
  unfold G₁ 𝓛G₁; rw [max_eq_left hB]
  constructor <;> intro h <;> linarith

/-- $Q_\beta(y)>0$ for $\beta\in[\frac12,1]$ and $y\in(0,1)$. -/
theorem Q_pos {β y : ℝ} (hβ : β ∈ Icc (2⁻¹ : ℝ) 1) (hy : y ∈ Ioo (0 : ℝ) 1) : 0 < Q β y := by
  rw [Q_eq_affine]
  have h1 := two_rpow_gt_of_half_le hβ.1
  have h2 := two_rpow_le_two_of_le_one hβ.2
  have hy1 : 0 < 1 - y := by linarith [hy.2]
  have : 0 < -3 + 12 * y + (4 - 8 * y) * 2 ^ β := by nlinarith [hy.1, hy.2]
  have : 0 < 2 / 3 * y * (1 - y) := by have := hy.1; positivity
  nlinarith

/-- A quadratic $a+bh-ch^2$ with $c\ge0$ is concave. -/
theorem concaveOn_quadratic {a b c : ℝ} (hc : 0 ≤ c) {s : Set ℝ} (hs : Convex ℝ s) :
    ConcaveOn ℝ s (fun h ↦ a + b * h - c * h ^ 2) := by
  refine ⟨hs, fun x _ y _ θ φ hθ hφ hθφ ↦ ?_⟩
  simp only [smul_eq_mul]
  have hφ' : φ = 1 - θ := by linarith
  subst hφ'
  nlinarith [mul_nonneg (mul_nonneg hθ hφ) (mul_nonneg hc (sq_nonneg (x - y)))]

/-- $2^{1/2}=\sqrt2$. -/
theorem two_rpow_half : (2 : ℝ) ^ (2⁻¹ : ℝ) = √2 := by rw [sqrt_eq_rpow]; norm_num

/-- $1.41421<\sqrt2<1.41422$. -/
theorem sqrt_two_mem : √2 ∈ Ioo (1.41421 : ℝ) 1.41422 :=
  ⟨by rw [lt_sqrt (by norm_num)]; norm_num, by rw [sqrt_lt' (by norm_num)]; norm_num⟩

/-- $\alpha_0(\frac12)=4\sqrt2-5$ and $\alpha_1(\frac12)=3-2\sqrt2$. -/
theorem α_half : α₀ 2⁻¹ = 4 * √2 - 5 ∧ α₁ 2⁻¹ = 3 - 2 * √2 := by
  rw [α₀, α₁, two_rpow_two_add, two_rpow_one_add, two_rpow_half]; exact ⟨rfl, rfl⟩

/-- $Q_\beta$ is monotone on $[0,\frac12]$ for $\beta\in[\frac12,\log_2\frac32)$ (Lemma 5.8). -/
theorem Q_monotoneOn {β : ℝ} (hβ : β ∈ Ico (2⁻¹ : ℝ) (log₂ (3 / 2))) :
    MonotoneOn (Q β) (Icc 0 2⁻¹) :=
  monotoneOn_of_deriv_nonneg (convex_Icc 0 2⁻¹) (continuous_Q β).continuousOn
    (fun x _ ↦ (hasDerivAt_Q β x).differentiableAt.differentiableWithinAt)
    fun x hx ↦ by
      rw [interior_Icc] at hx
      exact (lemma_5_8 x ⟨hx.1.le, hx.2.le⟩ β hβ).2.1.1.le

/-- $Q_{\frac12}(\frac14)=\frac{\sqrt2}4$, $Q_{\frac12}(\frac38)=\frac5{32}(\frac32+\sqrt2)$,
$Q_{\frac12}(\frac12)=\frac12$. -/
theorem Q_half_values : Q 2⁻¹ 4⁻¹ = √2 / 4 ∧ Q 2⁻¹ (3 / 8) = 5 / 32 * (3 / 2 + √2) ∧
    Q 2⁻¹ 2⁻¹ = 2⁻¹ := by
  refine ⟨?_, ?_, ?_⟩ <;> rw [Q_eq_affine, two_rpow_half] <;> ring

/-- Facts on $\beta\in\{\frac12,\beta_0\}$: $\beta<1$, $1<\beta^{-1}\le2$,
$\alpha_0,\alpha_1\ge0$. -/
theorem caseQ_β_facts {β : ℝ} (hβ : β = 2⁻¹ ∨ β = β₀) :
    β < 1 ∧ 1 < β⁻¹ ∧ β⁻¹ ≤ 2 ∧ 0 ≤ α₀ β ∧ 0 ≤ α₁ β := by
  have hβr := mem_Ico_of_caseQ hβ
  have hβ1 : β < 1 := by rcases hβ with rfl | rfl <;> norm_num [β₀]
  have hβ0 : 0 < β := by linarith [hβr.1]
  have hs := two_rpow_gt_of_half_le hβr.1
  refine ⟨hβ1, (one_lt_inv₀ hβ0).2 hβ1, ?_, ?_, ?_⟩
  · rw [inv_le_comm₀ hβ0 two_pos]; linarith [hβr.1]
  · rw [α₀, two_rpow_two_add]; linarith
  · rw [α₁, two_rpow_one_add]; linarith [two_rpow_le_three_halves hβr.2.le]

/-- The lower bound property of the tight lower bound $\underline{g_{Q,1,\beta}}$ ([DIR], §6.2.1),
with $g_{Q,1,\beta}$ in the form of `Auto.DIR.caseQ_II_g_Q_1_eq`: by monotonicity of $Q_\beta$ on
$[0,\frac12]$, for $0\le\underline h\le h\le\overline h\le\frac14$ and
$\frac14\le\underline y\le y\le\overline y\le\frac12$ ($\beta\in\{\frac12,\beta_0\}$). -/
theorem g_Q_1_lo_le {β : ℝ} (hβ : β = 2⁻¹ ∨ β = β₀) {hl hu yl yu h y : ℝ} (hhl : 0 ≤ hl)
    (hhu : hu ≤ 4⁻¹) (hyl : 4⁻¹ ≤ yl) (hyu : yu ≤ 2⁻¹) (hh : h ∈ Icc hl hu)
    (hy : y ∈ Icc yl yu) :
    β * Q β yu ^ (1 - β⁻¹) - (α₀ β - 2 * α₁ β * hl + 4 * α₁ β * yu) * hu ^ (2 - β⁻¹)
        - 2⁻¹ * β * (1 - β) * Q β yl ^ (1 - 2 / β) * hu ^ β⁻¹ ≤
      β * Q β y ^ (1 - β⁻¹) - (α₀ β - 2 * α₁ β * h + 4 * α₁ β * y) * h ^ (2 - β⁻¹)
        - 2⁻¹ * β * (1 - β) * Q β y ^ (1 - 2 / β) * h ^ β⁻¹ := by
  obtain ⟨hβ1, hbi1, hbi2, hα0, hα1⟩ := caseQ_β_facts hβ
  have hβr := mem_Ico_of_caseQ hβ
  have hβ0 : 0 < β := by linarith [hβr.1]
  have hmono := Q_monotoneOn hβr
  have hh0 : 0 ≤ h := hhl.trans hh.1
  have hyQ : ∀ z ∈ Icc yl yu, 0 < Q β z := fun z hz ↦
    Q_pos (mem_Icc_one_of_caseQ hβ) ⟨by linarith [hz.1], by linarith [hz.2]⟩
  have hQl : Q β yl ≤ Q β y := hmono ⟨by linarith, by linarith [hy.1, hy.2]⟩
    ⟨by linarith [hy.1], by linarith [hy.2]⟩ hy.1
  have hQu : Q β y ≤ Q β yu := hmono ⟨by linarith [hy.1], by linarith [hy.2]⟩
    ⟨by linarith [hy.1, hy.2], hyu⟩ hy.2
  have T1 : Q β yu ^ (1 - β⁻¹) ≤ Q β y ^ (1 - β⁻¹) :=
    rpow_le_rpow_of_nonpos (hyQ y hy) hQu (by linarith)
  have hK0 : 0 ≤ α₀ β - 2 * α₁ β * h + 4 * α₁ β * y := by
    nlinarith [mul_nonneg hα1 (show (0 : ℝ) ≤ 4 * y - 2 * h by linarith [hh.2, hy.1])]
  have hK : α₀ β - 2 * α₁ β * h + 4 * α₁ β * y ≤ α₀ β - 2 * α₁ β * hl + 4 * α₁ β * yu := by
    nlinarith [mul_le_mul_of_nonneg_left hh.1 hα1, mul_le_mul_of_nonneg_left hy.2 hα1]
  have hP2 : h ^ (2 - β⁻¹) ≤ hu ^ (2 - β⁻¹) := rpow_le_rpow hh0 hh.2 (by linarith)
  have T2 := mul_le_mul hK hP2 (rpow_nonneg hh0 _) (hK0.trans hK)
  have T3a : Q β y ^ (1 - 2 / β) ≤ Q β yl ^ (1 - 2 / β) := by
    refine rpow_le_rpow_of_nonpos (hyQ yl ⟨le_rfl, hy.1.trans hy.2⟩) hQl ?_
    rw [div_eq_mul_inv]; linarith
  have hP3 : h ^ β⁻¹ ≤ hu ^ β⁻¹ := rpow_le_rpow hh0 hh.2 (by linarith)
  have T3 := mul_le_mul T3a hP3 (rpow_nonneg hh0 _)
    (rpow_nonneg (hyQ yl ⟨le_rfl, hy.1.trans hy.2⟩).le _)
  have hc : 0 ≤ 2⁻¹ * β * (1 - β) := by have : 0 ≤ 1 - β := by linarith
                                        positivity
  have := mul_le_mul_of_nonneg_left T1 hβ0.le
  have := mul_le_mul_of_nonneg_left T3 hc
  nlinarith

/-! ### Case Q, region III: the quadratic $R_\beta(y)=y^{-1}Q_\beta(y)$ -/

/-- The quadratic $\frac23(1-y)(2^{\beta+2}-3+4(3-2^{\beta+1})y)$, equal to $y^{-1}Q_\beta(y)$ for
$y\ne0$. -/
noncomputable def Rp (β y : ℝ) : ℝ := 2 / 3 * (1 - y) * (2 ^ (β + 2) - 3 + 4 * (3 - 2 ^ (β + 1)) * y)

/-- The derivative of `Rp`. -/
noncomputable def Rp1 (β y : ℝ) : ℝ :=
  2 / 3 * (4 * (3 - 2 * 2 ^ β) - (4 * 2 ^ β - 3) - 2 * (4 * (3 - 2 * 2 ^ β)) * y)

/-- The second derivative of `Rp` (a constant). -/
noncomputable def Rp2 (β : ℝ) : ℝ := -4 / 3 * (4 * (3 - 2 * 2 ^ β))

/-- $y^{-1}Q_\beta(y)=$ `Rp β y` for $y\ne0$. -/
theorem inv_mul_Q_eq {β y : ℝ} (hy : y ≠ 0) : y⁻¹ * Q β y = Rp β y := by
  rw [Q, Rp]; field_simp

/-- `Rp β` has derivative `Rp1 β`. -/
theorem hasDerivAt_Rp (β y : ℝ) : HasDerivAt (Rp β) (Rp1 β y) y := by
  have h := ((((hasDerivAt_id' y).const_sub 1).const_mul (2 / 3)).mul
    (((hasDerivAt_id' y).const_mul (4 * (3 - (2 : ℝ) ^ (β + 1)))).const_add
      ((2 : ℝ) ^ (β + 2) - 3)))
  refine h.congr_deriv ?_
  rw [Rp1, two_rpow_add_two, two_rpow_add_one']; ring

/-- `Rp1 β` has derivative `Rp2 β`. -/
theorem hasDerivAt_Rp1 (β y : ℝ) : HasDerivAt (Rp1 β) (Rp2 β) y := by
  have h := (((hasDerivAt_id' y).const_mul (2 * (4 * (3 - 2 * (2 : ℝ) ^ β)))).const_sub
    (4 * (3 - 2 * (2 : ℝ) ^ β) - (4 * 2 ^ β - 3))).const_mul (2 / 3)
  refine h.congr_deriv ?_
  rw [Rp2]; ring

/-- `Rp β` and $y^{-1}Q_\beta(y)$ agree near any $y\ne0$. -/
theorem inv_mul_Q_eventuallyEq {β y : ℝ} (hy : y ≠ 0) :
    (fun z ↦ z⁻¹ * Q β z) =ᶠ[𝓝 y] Rp β := by
  filter_upwards [isOpen_ne.mem_nhds hy] with z hz using inv_mul_Q_eq hz

/-- Signs of $R_\beta=$ `Rp β` and its derivatives for $\beta\in\{\frac12,\beta_0\}$:
$R_\beta>0$ on $(0,1)$, $R_\beta'\le0$ on $[\frac18,1]$, $R_\beta''\le0$. -/
theorem Rp_signs {β : ℝ} (hβ : β = 2⁻¹ ∨ β = β₀) :
    (∀ y ∈ Ioo (0 : ℝ) 1, 0 < Rp β y) ∧ (∀ y, 8⁻¹ ≤ y → Rp1 β y ≤ 0) ∧ Rp2 β ≤ 0 := by
  have hβr := mem_Ico_of_caseQ hβ
  have hs := two_rpow_gt_of_half_le hβr.1
  have hs2 := two_rpow_le_three_halves hβr.2.le
  refine ⟨fun y hy ↦ ?_, fun y hy ↦ ?_, ?_⟩
  · rw [← inv_mul_Q_eq hy.1.ne']
    exact mul_pos (inv_pos.2 hy.1) (Q_pos (mem_Icc_one_of_caseQ hβ) hy)
  · rw [Rp1]; nlinarith
  · rw [Rp2]; nlinarith

/-- $y\mapsto y^{-1}Q_\beta(y)$ has derivative `Rp1 β y` at $y\ne0$. -/
theorem hasDerivAt_invQ {β y : ℝ} (hy : y ≠ 0) :
    HasDerivAt (fun z ↦ z⁻¹ * Q β z) (Rp1 β y) y :=
  (hasDerivAt_Rp β y).congr_of_eventuallyEq (inv_mul_Q_eventuallyEq hy)

/-- The derivative of $y^{-1}Q_\beta(y)$ is `Rp1 β` near $y\ne0$. -/
theorem deriv_invQ_eventuallyEq {β y : ℝ} (hy : y ≠ 0) :
    deriv (fun z ↦ z⁻¹ * Q β z) =ᶠ[𝓝 y] Rp1 β := by
  filter_upwards [isOpen_ne.mem_nhds hy] with z hz using (hasDerivAt_invQ hz).deriv

/-- The second derivative of $y^{-1}Q_\beta(y)$ is `Rp2 β` near $y\ne0$. -/
theorem deriv2_invQ_eventuallyEq {β y : ℝ} (hy : y ≠ 0) :
    deriv (deriv (fun z ↦ z⁻¹ * Q β z)) =ᶠ[𝓝 y] fun _ ↦ Rp2 β := by
  filter_upwards [isOpen_ne.mem_nhds hy] with z hz
  rw [(deriv_invQ_eventuallyEq hz).deriv_eq, (hasDerivAt_Rp1 β z).deriv]

/-! ### Case Q, region III: derivatives of $R^c$ and $yR'$ -/

section RpPow

variable {β c y : ℝ}

/-- $(R^c)'=cR^{c-1}R'$ where $R>0$ (with $R=$ `Rp β`). -/
theorem hasDerivAt_Rp_rpow (hR : 0 < Rp β y) :
    HasDerivAt (fun z ↦ Rp β z ^ c) (c * Rp β y ^ (c - 1) * Rp1 β y) y :=
  ((hasDerivAt_Rp β y).rpow_const (Or.inl hR.ne')).congr_deriv (by ring)

/-- $(cR^{c-1}R')'=c((c-1)R^{c-2}R'^2+R^{c-1}R'')$ where $R>0$. -/
theorem hasDerivAt_Rp_rpow_d1 (hR : 0 < Rp β y) :
    HasDerivAt (fun z ↦ c * Rp β z ^ (c - 1) * Rp1 β z)
      (c * ((c - 1) * Rp β y ^ (c - 2) * Rp1 β y ^ 2 + Rp β y ^ (c - 1) * Rp2 β)) y := by
  have h := ((hasDerivAt_Rp_rpow (c := c - 1) hR).const_mul c).mul (hasDerivAt_Rp1 β y)
  refine h.congr_deriv ?_
  rw [show c - 1 - 1 = c - 2 by ring]; ring

/-- $(c(c-1)R^{c-2}R'^2+cR^{c-1}R'')'=c(c-1)(c-2)R^{c-3}R'^3+3c(c-1)R^{c-2}R'R''$ where $R>0$
(as $R'''=0$). -/
theorem hasDerivAt_Rp_rpow_d2 (hR : 0 < Rp β y) :
    HasDerivAt
      (fun z ↦ c * ((c - 1) * Rp β z ^ (c - 2) * Rp1 β z ^ 2 + Rp β z ^ (c - 1) * Rp2 β))
      (c * (c - 1) * (c - 2) * Rp β y ^ (c - 3) * Rp1 β y ^ 3
        + 3 * c * (c - 1) * Rp β y ^ (c - 2) * Rp1 β y * Rp2 β) y := by
  have h1 := ((hasDerivAt_Rp_rpow (c := c - 2) hR).const_mul (c - 1)).mul
    ((hasDerivAt_Rp1 β y).pow 2)
  have h2 := (hasDerivAt_Rp_rpow (c := c - 1) hR).mul_const (Rp2 β)
  refine ((h1.add h2).const_mul c).congr_deriv ?_
  rw [show c - 2 - 1 = c - 3 by ring, show c - 1 - 1 = c - 2 by ring]
  simp only [Pi.pow_apply]
  push_cast; ring

/-- $(yR')'=R'+yR''$. -/
theorem hasDerivAt_mul_Rp1 (β y : ℝ) :
    HasDerivAt (fun z ↦ z * Rp1 β z) (Rp1 β y + y * Rp2 β) y :=
  ((hasDerivAt_id' y).mul (hasDerivAt_Rp1 β y)).congr_deriv (by ring)

/-- $(R'+yR'')'=2R''$. -/
theorem hasDerivAt_Rp1_add (β y : ℝ) :
    HasDerivAt (fun z ↦ Rp1 β z + z * Rp2 β) (2 * Rp2 β) y :=
  ((hasDerivAt_Rp1 β y).add ((hasDerivAt_id' y).mul_const (Rp2 β))).congr_deriv (by ring)

end RpPow

/-- $y\,R(y)^cR'(y)$ (with $R=$ `Rp β`) is differentiable where $R>0$. -/
theorem differentiableAt_f0p {β c y : ℝ} (hR : 0 < Rp β y) :
    DifferentiableAt ℝ (fun z ↦ z * Rp β z ^ c * Rp1 β z) y :=
  (((hasDerivAt_id' y).mul (hasDerivAt_Rp_rpow (c := c) hR)).mul
    (hasDerivAt_Rp1 β y)).differentiableAt

/-- If $f=g$ on an open set $U$ and $g'$ is the derivative of $g$ on $U$, then $f'=g'$ on $U$. -/
theorem eqOn_deriv_of_eqOn {f g g' : ℝ → ℝ} {U : Set ℝ} (hU : IsOpen U) (h : EqOn f g U)
    (hg : ∀ z ∈ U, HasDerivAt g (g' z) z) : EqOn (deriv f) g' U := fun z hz ↦ by
  have : f =ᶠ[𝓝 z] g := by
    filter_upwards [hU.mem_nhds hz] with w hw using h hw
  rw [this.deriv_eq, (hg z hz).deriv]

/-! ### Case Q, region III: the derivatives of $f_{\beta,0}=f_{\beta,1}f_{\beta,2}$ -/

/-- $f_{\beta,1}=R^c$ (with $R=$ `Rp β`, $c=\frac1\beta-1$). -/
noncomputable def F1 (β c y : ℝ) : ℝ := Rp β y ^ c

/-- $f_{\beta,1}'=cR^{c-1}R'$. -/
noncomputable def G1 (β c y : ℝ) : ℝ := c * Rp β y ^ (c - 1) * Rp1 β y

/-- $f_{\beta,1}''=c((c-1)R^{c-2}R'^2+R^{c-1}R'')$. -/
noncomputable def G2 (β c y : ℝ) : ℝ :=
  c * ((c - 1) * Rp β y ^ (c - 2) * Rp1 β y ^ 2 + Rp β y ^ (c - 1) * Rp2 β)

/-- $f_{\beta,1}'''=c(c-1)(c-2)R^{c-3}R'^3+3c(c-1)R^{c-2}R'R''$. -/
noncomputable def G3 (β c y : ℝ) : ℝ :=
  c * (c - 1) * (c - 2) * Rp β y ^ (c - 3) * Rp1 β y ^ 3
    + 3 * c * (c - 1) * Rp β y ^ (c - 2) * Rp1 β y * Rp2 β

/-- $f_{\beta,2}=yR'$. -/
noncomputable def F2 (β y : ℝ) : ℝ := y * Rp1 β y

/-- $f_{\beta,2}'=R'+yR''$. -/
noncomputable def F2d (β y : ℝ) : ℝ := Rp1 β y + y * Rp2 β

/-- $f_{\beta,0}'=f_{\beta,1}'f_{\beta,2}+f_{\beta,1}f_{\beta,2}'$. -/
noncomputable def D1 (β c y : ℝ) : ℝ := G1 β c y * F2 β y + F1 β c y * F2d β y

/-- $f_{\beta,0}''=f_{\beta,1}''f_{\beta,2}+2f_{\beta,1}'f_{\beta,2}'+f_{\beta,1}f_{\beta,2}''$
($f_{\beta,2}''=2R''$). -/
noncomputable def D2 (β c y : ℝ) : ℝ :=
  G2 β c y * F2 β y + 2 * G1 β c y * F2d β y + F1 β c y * (2 * Rp2 β)

/-- $f_{\beta,0}'''=f_{\beta,1}'''f_{\beta,2}+3f_{\beta,1}''f_{\beta,2}'+3f_{\beta,1}'f_{\beta,2}''$. -/
noncomputable def D3 (β c y : ℝ) : ℝ :=
  G3 β c y * F2 β y + 3 * G2 β c y * F2d β y + 3 * G1 β c y * (2 * Rp2 β)

section RpDerivs

variable {β c y : ℝ}

theorem hasDerivAt_F1 (hR : 0 < Rp β y) : HasDerivAt (F1 β c) (G1 β c y) y :=
  hasDerivAt_Rp_rpow hR

theorem hasDerivAt_G1 (hR : 0 < Rp β y) : HasDerivAt (G1 β c) (G2 β c y) y :=
  hasDerivAt_Rp_rpow_d1 hR

theorem hasDerivAt_G2 (hR : 0 < Rp β y) : HasDerivAt (G2 β c) (G3 β c y) y :=
  hasDerivAt_Rp_rpow_d2 hR

theorem hasDerivAt_F2 : HasDerivAt (F2 β) (F2d β y) y := hasDerivAt_mul_Rp1 β y

theorem hasDerivAt_F2d : HasDerivAt (F2d β) (2 * Rp2 β) y := hasDerivAt_Rp1_add β y

/-- $(f_{\beta,1}f_{\beta,2})'=$ `D1`. -/
theorem hasDerivAt_F1F2 (hR : 0 < Rp β y) :
    HasDerivAt (fun z ↦ F1 β c z * F2 β z) (D1 β c y) y :=
  ((hasDerivAt_F1 hR).mul hasDerivAt_F2).congr_deriv (by rw [D1])

theorem hasDerivAt_D1 (hR : 0 < Rp β y) : HasDerivAt (D1 β c) (D2 β c y) y :=
  (((hasDerivAt_G1 hR).mul hasDerivAt_F2).add ((hasDerivAt_F1 hR).mul hasDerivAt_F2d))
    |>.congr_deriv (by rw [D2]; ring)

theorem hasDerivAt_D2 (hR : 0 < Rp β y) : HasDerivAt (D2 β c) (D3 β c y) y :=
  ((((hasDerivAt_G2 (c := c) hR).mul hasDerivAt_F2).add
    (((hasDerivAt_G1 (c := c) hR).const_mul 2).mul hasDerivAt_F2d)).add
      ((hasDerivAt_F1 (c := c) hR).mul_const (2 * Rp2 β))) |>.congr_deriv (by rw [D3]; ring)

end RpDerivs

/-- Signs on $[\frac18,\frac12]$ for $\beta\in\{\frac12,\beta_0\}$, $c=\frac1\beta-1$:
$f_{\beta,1}',f_{\beta,1}'',f_{\beta,1}'''\le0$, $f_{\beta,2},f_{\beta,2}',f_{\beta,2}''\le0$, hence
$f_{\beta,0}'''\ge0$. -/
theorem D3_nonneg {β y : ℝ} (hβ : β = 2⁻¹ ∨ β = β₀) (hy : y ∈ Icc (8⁻¹ : ℝ) 2⁻¹) :
    G1 β (β⁻¹ - 1) y ≤ 0 ∧ G2 β (β⁻¹ - 1) y ≤ 0 ∧ G3 β (β⁻¹ - 1) y ≤ 0 ∧ F2 β y ≤ 0 ∧
      F2d β y ≤ 0 ∧ 0 ≤ D3 β (β⁻¹ - 1) y := by
  obtain ⟨-, hb1, hb2, -, -⟩ := caseQ_β_facts hβ
  obtain ⟨hR, hR1, hR2⟩ := Rp_signs hβ
  have hy0 : 0 < y := by linarith [hy.1]
  have r := hR y ⟨hy0, by linarith [hy.2]⟩
  have r1 := hR1 y hy.1
  set c := β⁻¹ - 1
  have hc : 0 < c := by linarith
  have hc1 : c - 1 ≤ 0 := by linarith
  have hc2 : c - 2 < 0 := by linarith
  have p1 : 0 < Rp β y ^ (c - 1) := rpow_pos_of_pos r _
  have p2 : 0 < Rp β y ^ (c - 2) := rpow_pos_of_pos r _
  have p3 : 0 < Rp β y ^ (c - 3) := rpow_pos_of_pos r _
  have g1 : G1 β c y ≤ 0 := by
    rw [G1]; exact mul_nonpos_of_nonneg_of_nonpos (by positivity) r1
  have g2 : G2 β c y ≤ 0 := by
    rw [G2]
    refine mul_nonpos_of_nonneg_of_nonpos hc.le (add_nonpos ?_ ?_)
    · exact mul_nonpos_of_nonpos_of_nonneg (mul_nonpos_of_nonpos_of_nonneg hc1 p2.le) (sq_nonneg _)
    · exact mul_nonpos_of_nonneg_of_nonpos p1.le hR2
  have g3 : G3 β c y ≤ 0 := by
    rw [G3]
    have k1 : 0 ≤ c * (c - 1) * (c - 2) :=
      mul_nonneg_of_nonpos_of_nonpos (mul_nonpos_of_nonneg_of_nonpos hc.le hc1) hc2.le
    have k2 : Rp1 β y ^ 3 ≤ 0 := by
      have : Rp1 β y ^ 3 = Rp1 β y * Rp1 β y ^ 2 := by ring
      rw [this]; exact mul_nonpos_of_nonpos_of_nonneg r1 (sq_nonneg _)
    have k3 : 0 ≤ Rp1 β y * Rp2 β := mul_nonneg_of_nonpos_of_nonpos r1 hR2
    have k4 : 3 * c * (c - 1) ≤ 0 := by nlinarith
    nlinarith [mul_nonneg (mul_nonneg k1 p3.le) (neg_nonneg.2 k2),
      mul_nonneg (neg_nonneg.2 k4) (mul_nonneg p2.le k3)]
  have f2 : F2 β y ≤ 0 := by rw [F2]; exact mul_nonpos_of_nonneg_of_nonpos hy0.le r1
  have f2d : F2d β y ≤ 0 := by
    rw [F2d]; linarith [mul_nonpos_of_nonneg_of_nonpos hy0.le hR2]
  refine ⟨g1, g2, g3, f2, f2d, ?_⟩
  rw [D3]
  nlinarith [mul_nonneg_of_nonpos_of_nonpos g3 f2, mul_nonneg_of_nonpos_of_nonpos g2 f2d,
    mul_nonneg_of_nonpos_of_nonpos g1 hR2]

/-- The derivatives of $f_{\beta,1}=R_\beta^c$, $R_\beta(y)=y^{-1}Q_\beta(y)$, on $(0,1)$. -/
theorem derivs_f1 {β : ℝ} (hβ : β = 2⁻¹ ∨ β = β₀) (c : ℝ) :
    EqOn (fun y ↦ (y⁻¹ * Q β y) ^ c) (F1 β c) (Ioo 0 1) ∧
      EqOn (deriv (fun y ↦ (y⁻¹ * Q β y) ^ c)) (G1 β c) (Ioo 0 1) ∧
      EqOn (deriv (deriv (fun y ↦ (y⁻¹ * Q β y) ^ c))) (G2 β c) (Ioo 0 1) ∧
      EqOn (deriv (deriv (deriv (fun y ↦ (y⁻¹ * Q β y) ^ c)))) (G3 β c) (Ioo 0 1) := by
  have hR := (Rp_signs hβ).1
  have e : EqOn (fun y ↦ (y⁻¹ * Q β y) ^ c) (F1 β c) (Ioo 0 1) := fun z hz ↦ by
    simp only [F1, inv_mul_Q_eq hz.1.ne']
  have d1 := eqOn_deriv_of_eqOn isOpen_Ioo e fun z hz ↦ hasDerivAt_F1 (hR z hz)
  have d2 := eqOn_deriv_of_eqOn isOpen_Ioo d1 fun z hz ↦ hasDerivAt_G1 (hR z hz)
  exact ⟨e, d1, d2, eqOn_deriv_of_eqOn isOpen_Ioo d2 fun z hz ↦ hasDerivAt_G2 (hR z hz)⟩

/-- The derivatives of $f_{\beta,2}=yR_\beta'(y)$ on $(0,1)$. -/
theorem derivs_f2 (β : ℝ) :
    EqOn (fun y ↦ y * deriv (fun z ↦ z⁻¹ * Q β z) y) (F2 β) (Ioo 0 1) ∧
      EqOn (deriv (fun y ↦ y * deriv (fun z ↦ z⁻¹ * Q β z) y)) (F2d β) (Ioo 0 1) ∧
      EqOn (deriv (deriv (fun y ↦ y * deriv (fun z ↦ z⁻¹ * Q β z) y))) (fun _ ↦ 2 * Rp2 β)
        (Ioo 0 1) ∧
      EqOn (deriv (deriv (deriv (fun y ↦ y * deriv (fun z ↦ z⁻¹ * Q β z) y)))) (fun _ ↦ 0)
        (Ioo 0 1) := by
  have e : EqOn (fun y ↦ y * deriv (fun z ↦ z⁻¹ * Q β z) y) (F2 β) (Ioo 0 1) := fun z hz ↦ by
    simp only [F2, (hasDerivAt_invQ hz.1.ne').deriv]
  have d1 := eqOn_deriv_of_eqOn isOpen_Ioo e fun z _ ↦ hasDerivAt_F2
  have d2 := eqOn_deriv_of_eqOn isOpen_Ioo d1 fun z _ ↦ hasDerivAt_F2d
  exact ⟨e, d1, d2, eqOn_deriv_of_eqOn isOpen_Ioo d2 fun z _ ↦ hasDerivAt_const z _⟩

/-- The derivatives of $f_{\beta,0}=yR_\beta(y)^cR_\beta'(y)$ on $(0,1)$. -/
theorem derivs_f0 {β : ℝ} (hβ : β = 2⁻¹ ∨ β = β₀) (c : ℝ) :
    EqOn (deriv (fun y ↦ y * (y⁻¹ * Q β y) ^ c * deriv (fun z ↦ z⁻¹ * Q β z) y)) (D1 β c)
        (Ioo 0 1) ∧
      EqOn (deriv (deriv (fun y ↦ y * (y⁻¹ * Q β y) ^ c * deriv (fun z ↦ z⁻¹ * Q β z) y)))
        (D2 β c) (Ioo 0 1) ∧
      EqOn (deriv (deriv (deriv
        (fun y ↦ y * (y⁻¹ * Q β y) ^ c * deriv (fun z ↦ z⁻¹ * Q β z) y)))) (D3 β c)
        (Ioo 0 1) := by
  have hR := (Rp_signs hβ).1
  have e : EqOn (fun y ↦ y * (y⁻¹ * Q β y) ^ c * deriv (fun z ↦ z⁻¹ * Q β z) y)
      (fun z ↦ F1 β c z * F2 β z) (Ioo 0 1) := fun z hz ↦ by
    simp only [F1, F2, inv_mul_Q_eq hz.1.ne', (hasDerivAt_invQ hz.1.ne').deriv]; ring
  have d1 := eqOn_deriv_of_eqOn isOpen_Ioo e fun z hz ↦ hasDerivAt_F1F2 (hR z hz)
  have d2 := eqOn_deriv_of_eqOn isOpen_Ioo d1 fun z hz ↦ hasDerivAt_D1 (hR z hz)
  exact ⟨d1, d2, eqOn_deriv_of_eqOn isOpen_Ioo d2 fun z hz ↦ hasDerivAt_D2 (hR z hz)⟩

/-- $f_{\beta,0}''=$ `D2` is monotone on $[\frac18,\frac12]$ ($f_{\beta,0}'''\ge0$). -/
theorem D2_monotoneOn {β : ℝ} (hβ : β = 2⁻¹ ∨ β = β₀) :
    MonotoneOn (D2 β (β⁻¹ - 1)) (Icc 8⁻¹ 2⁻¹) := by
  have hR := (Rp_signs hβ).1
  have hd : ∀ z ∈ Icc (8⁻¹ : ℝ) 2⁻¹, HasDerivAt (D2 β (β⁻¹ - 1)) (D3 β (β⁻¹ - 1) z) z :=
    fun z hz ↦ hasDerivAt_D2 (hR z ⟨by linarith [hz.1], by linarith [hz.2]⟩)
  refine monotoneOn_of_deriv_nonneg (convex_Icc _ _)
    (fun z hz ↦ (hd z hz).continuousAt.continuousWithinAt)
    (fun z hz ↦ (hd z (interior_subset hz)).differentiableAt.differentiableWithinAt)
    fun z hz ↦ ?_
  rw [(hd z (interior_subset hz)).deriv]
  exact (D3_nonneg hβ (interior_subset hz)).2.2.2.2.2

/-- If $f_{\beta,0}''=$ `D2` $\ge0$ on $[a,\frac12]\subset[\frac18,\frac12]$, then
$f_{\beta,0}'=$ `D1` is monotone there. -/
theorem D1_monotoneOn {β a : ℝ} (hβ : β = 2⁻¹ ∨ β = β₀) (ha : 8⁻¹ ≤ a)
    (h : ∀ z ∈ Icc a 2⁻¹, 0 ≤ D2 β (β⁻¹ - 1) z) : MonotoneOn (D1 β (β⁻¹ - 1)) (Icc a 2⁻¹) := by
  have hR := (Rp_signs hβ).1
  have hd : ∀ z ∈ Icc a 2⁻¹, HasDerivAt (D1 β (β⁻¹ - 1)) (D2 β (β⁻¹ - 1) z) z :=
    fun z hz ↦ hasDerivAt_D1 (hR z ⟨by linarith [hz.1], by linarith [hz.2]⟩)
  refine monotoneOn_of_deriv_nonneg (convex_Icc _ _)
    (fun z hz ↦ (hd z hz).continuousAt.continuousWithinAt)
    (fun z hz ↦ (hd z (interior_subset hz)).differentiableAt.differentiableWithinAt)
    fun z hz ↦ ?_
  rw [(hd z (interior_subset hz)).deriv]
  exact h z (interior_subset hz)

/-- $f_\beta(y)=1+R_\beta(y)^{1/\beta}-R_\beta(\frac y2)^{1/\beta}$ is differentiable on $(0,1)$. -/
theorem differentiableAt_fQIII {β y : ℝ} (hβ : β = 2⁻¹ ∨ β = β₀) (hy : y ∈ Ioo (0 : ℝ) 1) :
    DifferentiableAt ℝ
      (fun z ↦ 1 + (z⁻¹ * Q β z) ^ β⁻¹ - ((z / 2)⁻¹ * Q β (z / 2)) ^ β⁻¹) y := by
  have hR := (Rp_signs hβ).1
  have h1 : 0 < y⁻¹ * Q β y := by rw [inv_mul_Q_eq hy.1.ne']; exact hR y hy
  have h2 : 0 < (y / 2)⁻¹ * Q β (y / 2) := by
    rw [inv_mul_Q_eq (by linarith [hy.1])]; exact hR _ ⟨by linarith [hy.1], by linarith [hy.2]⟩
  have d1 := ((hasDerivAt_invQ (β := β) hy.1.ne').differentiableAt).rpow_const (p := β⁻¹)
    (Or.inl h1.ne')
  have d2 : DifferentiableAt ℝ (fun z ↦ ((z / 2)⁻¹ * Q β (z / 2)) ^ β⁻¹) y :=
    (((hasDerivAt_invQ (β := β) (y := y / 2) (by linarith [hy.1])).comp y
      ((hasDerivAt_id' y).div_const 2)).differentiableAt).rpow_const (p := β⁻¹)
      (Or.inl (show ((fun z ↦ z⁻¹ * Q β z) ∘ fun x ↦ x / 2) y ≠ 0 from h2.ne'))
  exact (d1.const_add 1).sub d2

end Auto.DIR
