/-- Boolean check: the checker encloses $\log q$ in $[a,b]$. -/
def logCheck (q a b : ℚ) : Bool :=
  match Checker.logIv Checker.P0 q with
  | some (l, u) => decide (a ≤ l ∧ u ≤ b)
  | none => false

/-- Soundness of `logCheck`. -/
theorem log_mem_of_check {q a b : ℚ} (h : logCheck q a b = true) : log q ∈ Icc (a : ℝ) b := by
  unfold logCheck at h
  rcases he : Checker.logIv Checker.P0 q with _ | ⟨l, u⟩ <;> rw [he] at h
  · cases h
  obtain ⟨h1, h2⟩ := of_decide_eq_true h
  have hm := (Checker.logIv_sound Checker.P0 he).2
  exact ⟨(show (a : ℝ) ≤ l by exact_mod_cast h1).trans hm.1,
    hm.2.trans (show (u : ℝ) ≤ b by exact_mod_cast h2)⟩

/-- $L'(x)=(\log\frac1x-\frac12)/\sqrt{\log2\cdot\log\frac1x}$ for $L=L_{1/2}$, $x\in(0,1)$. -/
theorem deriv_L_half_eq {x : ℝ} (hx : x ∈ Ioo (0 : ℝ) 1) :
    deriv (L 2⁻¹) x = (log x⁻¹ - 2⁻¹) / √(log 2 * log x⁻¹) := by
  have hu : 0 < log x⁻¹ := log_pos ((one_lt_inv₀ hx.1).2 hx.2)
  have hl : 0 < log 2 := log_pos one_lt_two
  have hs : ∀ a : ℝ, a ^ (2⁻¹ : ℝ) = √a := fun a ↦ by rw [sqrt_eq_rpow]; norm_num
  rw [deriv_L_eq hx, L1f, show (-1 : ℝ) + 2⁻¹ = -2⁻¹ by norm_num, rpow_neg hl.le,
    rpow_neg hu.le, hs, hs, sqrt_mul hl.le]
  have : 0 < √(log 2) := sqrt_pos.2 hl
  have : 0 < √(log x⁻¹) := sqrt_pos.2 hu
  field_simp
  ring

/-- $\Phi^{-1}(\frac{13}{29})\in[-\sqrt2s_l,-\sqrt2s_u]$,
$s_{l,u}=0.0919370219367\ldots\pm10^{-13}$. -/
theorem gInv_13_29 :
    -(√2 * 0.0919370219368073) ≤ gInv (13 / 29) ∧ gInv (13 / 29) ≤ -(√2 * 0.0919370219366073) := by
  have h := gInv_mem_of_phi (t := ((13 / 29 : ℚ) : ℝ)) ⟨by norm_num, by norm_num⟩
    (sl := 0.0919370219368073) (su := 0.0919370219366073) (by norm_num) (by norm_num)
    (by exact_mod_cast (by decide +kernel : Checker.phiNegHi Checker.P0 0.0919370219368073 ≤
      13 / 29))
    (by exact_mod_cast (by decide +kernel : (13 / 29 : ℚ) ≤
      Checker.phiNegLo Checker.P0 0.0919370219366073))
  push_cast at h
  exact h

