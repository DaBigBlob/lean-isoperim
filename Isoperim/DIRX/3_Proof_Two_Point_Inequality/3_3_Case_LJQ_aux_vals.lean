/-! ### Values of $\Phi^{-1}/\sqrt2$ -/

/-- A certified enclosure of $\Phi^{-1}(t)/\sqrt2$ at a rational point $t$. -/
structure GiPt where
  /-- The point. -/
  t : ℚ
  /-- Lower end. -/
  l : ℚ
  /-- Upper end. -/
  u : ℚ
  /-- The enclosure. -/
  h : gInv t / √2 ∈ Icc (l : ℝ) u

/-- Boolean check of $\Phi(-\sqrt2s_l)\le t\le\Phi(-\sqrt2s_u)$ (via `phiNegHi`, `phiNegLo`). -/
def giCheck (t sl su : ℚ) : Bool :=
  decide (0 ≤ sl ∧ 0 ≤ su ∧ 0 < t ∧ t < 1 ∧ phiNegHi P0 sl ≤ t ∧ t ≤ phiNegLo P0 su)

/-- Soundness of `giCheck`: $\Phi^{-1}(t)/\sqrt2\in[-s_l,-s_u]$. -/
theorem gInv_div_mem {t sl su : ℚ} (h : giCheck t sl su = true) :
    gInv t / √2 ∈ Icc (-(sl : ℝ)) (-su) := by
  obtain ⟨h1, h2, h3, h4, h5, h6⟩ := of_decide_eq_true h
  have hm := gInv_mem_of_phi (t := (t : ℝ)) ⟨by exact_mod_cast h3, by exact_mod_cast h4⟩
    h1 h2 (by exact_mod_cast h5) (by exact_mod_cast h6)
  have hs : 0 < √2 := by positivity
  constructor
  · rw [le_div_iff₀ hs]; linarith [hm.1]
  · rw [div_le_iff₀ hs]; linarith [hm.2]

/-- A `GiPt` for $t<\frac12$ (witnesses $s_l\ge s\ge s_u$ with $\Phi^{-1}(t)=-\sqrt2s$). -/
noncomputable def GiPt.lo (t sl su : ℚ) (h : giCheck t sl su = true) : GiPt :=
  ⟨t, -sl, -su, by push_cast; exact gInv_div_mem h⟩

/-- A `GiPt` for $t>\frac12$, via $\Phi^{-1}(t)=-\Phi^{-1}(1-t)$. -/
noncomputable def GiPt.hi (t sl su : ℚ) (h : giCheck (1 - t) sl su = true) : GiPt :=
  ⟨t, su, sl, by
    have hm := gInv_div_mem h
    obtain ⟨-, -, h3, h4, -, -⟩ := of_decide_eq_true h
    have ht : (t : ℝ) ∈ Ioo 0 1 := by
      constructor
      · have : (t : ℚ) < 1 := by linarith
        have : (0 : ℚ) < t := by linarith
        exact_mod_cast this
      · have : (0 : ℚ) < 1 - t := h3
        have : t < (1 : ℚ) := by linarith
        exact_mod_cast this
    have e : gInv (t : ℝ) = -gInv (((1 - t : ℚ)) : ℝ) := by
      push_cast; rw [show (t : ℝ) = 1 - (1 - t) by ring, gInv_one_sub (by
        constructor <;> linarith [ht.1, ht.2]), sub_sub_cancel]
    rw [e, neg_div]
    exact ⟨by linarith [hm.2], by linarith [hm.1]⟩⟩

/-- The exact value $\Phi^{-1}(\frac12)/\sqrt2=0$. -/
noncomputable def GiPt.half : GiPt :=
  ⟨1 / 2, 0, 0, by rw [show ((1 / 2 : ℚ) : ℝ) = 2⁻¹ by norm_num, gInv_half]; simp⟩

/-- The environment entry of a `GiPt`. -/
noncomputable def GiPt.cert (p : GiPt) : Cert := ⟨p.l, p.u, gInv p.t / √2, p.h⟩

/-! ### Values of $L$ -/

/-- A certified enclosure of $L(x)=L_{1/2}(x)$ at a rational point $x$. -/
structure LPt where
  /-- The point. -/
  x : ℚ
  /-- Lower end. -/
  l : ℚ
  /-- Upper end. -/
  u : ℚ
  /-- The enclosure. -/
  h : L 2⁻¹ x ∈ Icc (l : ℝ) u

/-- Boolean check for an `LPt`: $\log\frac1x\in[a,b]$ (checker), and $c^2\log2\le a$,
$\log2\le a$, $b\le C^2\log2$ with $\log2\in[0.6931471803,0.6931471808]$. -/
def lCheck (x a b c C : ℚ) : Bool :=
  logCheck x⁻¹ a b && decide (0 < x ∧ x ≤ 1 / 2 ∧ c ^ 2 * (6931471808 / 10 ^ 10) ≤ a ∧
    6931471808 / 10 ^ 10 ≤ a ∧ b ≤ C ^ 2 * (6931471803 / 10 ^ 10) ∧ 0 ≤ C)

/-- Soundness of `lCheck`: $L(x)\in[xc,xC]$. -/
theorem L_mem_of_check {x a b c C : ℚ} (h : lCheck x a b c C = true) :
    L 2⁻¹ x ∈ Icc ((x * c : ℚ) : ℝ) (x * C : ℚ) := by
  simp only [lCheck, Bool.and_eq_true] at h
  obtain ⟨h1, h2⟩ := h
  obtain ⟨hx0, hx1, hc, ha1, hb, hC⟩ := of_decide_eq_true h2
  have hlog := log_mem_of_check h1
  have hl1 := log_two_gt_d9
  have hl2 := log_two_lt_d9
  have hl : 0 < log 2 := by linarith
  have hx0' : (0 : ℝ) < x := by exact_mod_cast hx0
  have hlb : log₂ (x : ℝ)⁻¹ = log ((x⁻¹ : ℚ) : ℝ) / log 2 := by rw [logb]; push_cast; rfl
  have hc' : ((c : ℝ)) ^ 2 * 0.6931471808 ≤ a := by
    have : ((c : ℝ)) ^ 2 * ((6931471808 / 10 ^ 10 : ℚ) : ℝ) ≤ a := by exact_mod_cast hc
    norm_num at this ⊢; linarith
  have ha1' : (0.6931471808 : ℝ) ≤ a := by
    have : ((6931471808 / 10 ^ 10 : ℚ) : ℝ) ≤ a := by exact_mod_cast ha1
    norm_num at this ⊢; linarith
  have hb' : (b : ℝ) ≤ C ^ 2 * 0.6931471803 := by
    have : (b : ℝ) ≤ (C : ℝ) ^ 2 * ((6931471803 / 10 ^ 10 : ℚ) : ℝ) := by exact_mod_cast hb
    norm_num at this ⊢; linarith
  have hlo : (a : ℝ) / 0.6931471808 ≤ log₂ (x : ℝ)⁻¹ := by
    rw [hlb]; exact div_le_div₀ (by linarith [hlog.1, ha1']) hlog.1 hl (by linarith)
  have hhi : log₂ (x : ℝ)⁻¹ ≤ (b : ℝ) / 0.6931471803 := by
    rw [hlb]
    exact div_le_div₀ (by linarith [hlog.1, hlog.2, ha1']) hlog.2 (by norm_num) (by linarith)
  push_cast
  constructor
  · exact L_ge_of_le_logb (by norm_num) hx0' (by rw [le_div_iff₀ (by norm_num)]; linarith) hlo
      (by rw [le_div_iff₀ (by norm_num)]; linarith)
  · have := L_le_of_logb_le (β := 2⁻¹) (βu := 2⁻¹) le_rfl le_rfl (by norm_num) hx0'
      (by have h := (Rat.cast_le (K := ℝ)).2 hx1
          push_cast at h; linarith) hhi (show (0 : ℝ) ≤ (C : ℝ) by exact_mod_cast hC)
      (by rw [div_le_iff₀ (by norm_num)]; linarith)
    simpa using this

/-- An `LPt` from a successful `lCheck`. -/
noncomputable def LPt.mk' (x a b c C : ℚ) (h : lCheck x a b c C = true) : LPt :=
  ⟨x, x * c, x * C, L_mem_of_check h⟩

/-- The environment entry of an `LPt`. -/
noncomputable def LPt.cert (p : LPt) : Cert := ⟨p.l, p.u, L 2⁻¹ p.x, p.h⟩

/-! ### Expressions -/

/-- $\mathrm J(y)$ from the entry $J_{w_1}(y)$ (variable $i$) and $J_{w_1}(\frac12)$ (variable $0$). -/
def exJ (i : ℕ) : Ex := .div (.var i) (.mul (.const 2) (.var 0))

/-- $Q(z)=Q_{1/2}(z)$ for rational $z$ in terms of $\sqrt2$ (variable $1$). -/
def exQh (z : ℚ) : Ex :=
  .add (.const (2 / 3 * z * (1 - z) * (-3 + 12 * z)))
    (.mul (.const (2 / 3 * z * (1 - z) * (4 - 8 * z))) (.var 1))

/-- $Q'(z)$ for rational $z$ in terms of $\sqrt2$ (variable $1$). -/
def exQ1h (z : ℚ) : Ex :=
  .add (.const (-2 + 20 * z - 24 * z ^ 2)) (.mul (.const (8 / 3 - 16 * z + 16 * z ^ 2)) (.var 1))

/-- The standard environment variables: $0\mapsto J_{w_1}(\frac12)$, $1\mapsto\sqrt2$. -/
theorem val_std (cs : List Cert) :
    Cert.val (cJhalf :: cSqrt2 :: cs) 0 = gJw w₁ 2⁻¹ ∧ Cert.val (cJhalf :: cSqrt2 :: cs) 1 = √2 :=
  ⟨rfl, rfl⟩

/-- `exJ` denotes $\mathrm J$. -/
theorem denote_exJ {ρ : ℕ → ℝ} {i : ℕ} {y : ℝ} (h0 : ρ 0 = gJw w₁ 2⁻¹) (hi : ρ i = gJw w₁ y) :
    denote ρ (exJ i) = JX y := by
  simp only [exJ, denote, h0, hi, JX_eq_div]; push_cast; rfl

/-- `exQh` denotes $Q_{1/2}$. -/
theorem denote_exQh {ρ : ℕ → ℝ} (h1 : ρ 1 = √2) (z : ℚ) : denote ρ (exQh z) = Q 2⁻¹ z := by
  simp only [exQh, denote, h1]; rw [Q_eq_affine, two_rpow_half]; push_cast; ring

/-- `exQ1h` denotes $Q_{1/2}'$. -/
theorem denote_exQ1h {ρ : ℕ → ℝ} (h1 : ρ 1 = √2) (z : ℚ) :
    denote ρ (exQ1h z) = deriv (Q 2⁻¹) z := by
  simp only [exQ1h, denote, h1]; rw [deriv_Q_eq, Q1f_eq_affine, two_rpow_half]; push_cast; ring


/-- $\mathrm J'(y)$ from the entry $\Phi^{-1}(\frac{1-y}{w_1})/\sqrt2$ (variable $i$) and
$J_{w_1}(\frac12)$ (variable $0$). -/
def exDJ (i : ℕ) : Ex := .div (.var i) (.var 0)

/-- `exDJ` denotes $\mathrm J'$. -/
theorem denote_exDJ {ρ : ℕ → ℝ} {i : ℕ} {y t : ℝ} (hy : y ∈ Ioo (1 - w₁) 1)
    (ht : t = w₁⁻¹ * (1 - y)) (h0 : ρ 0 = gJw w₁ 2⁻¹) (hi : ρ i = gInv t / √2) :
    denote ρ (exDJ i) = deriv JX y := by
  simp only [exDJ, denote, h0, hi, deriv_JX_eq hy, ht]
  rw [div_div, mul_comm (√2)]

