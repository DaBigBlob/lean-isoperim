/-- $G_1[B](x,y)=\sqrt{(y-x)^2+B(y)^2}+B(x)-2B(\frac{x+y}2)$ for $\beta=\frac12$. -/
theorem G₁_half_eq (B : ℝ → ℝ) (x y : ℝ) :
    Auto.DIR.G₁ 2⁻¹ B x y = √((y - x) ^ 2 + B y ^ 2) + B x - 2 * B ((x + y) / 2) := by
  have hs : ∀ a : ℝ, a ^ (2⁻¹ : ℝ) = √a := fun a ↦ by rw [sqrt_eq_rpow]; norm_num
