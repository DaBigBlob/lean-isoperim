/-- $G_1[B](x,y)=\sqrt{(y-x)^2+B(y)^2}+B(x)-2B(\frac{x+y}2)$ for $\beta=\frac12$. -/
theorem G₁_half_eq (B : ℝ → ℝ) (x y : ℝ) :
    Auto.DIR.G₁ 2⁻¹ B x y = √((y - x) ^ 2 + B y ^ 2) + B x - 2 * B ((x + y) / 2) := by
  have hs : ∀ a : ℝ, a ^ (2⁻¹ : ℝ) = √a := fun a ↦ by rw [sqrt_eq_rpow]; norm_num
  simp only [Auto.DIR.G₁, inv_inv, rpow_two, hs]

/-- $B_{w_1}=Q$ on $[\frac14,\frac12]$. -/
theorem BX_eq_Q {t : ℝ} (ht : t ∈ Icc (4⁻¹ : ℝ) 2⁻¹) : BX w₁ t = Q 2⁻¹ t := by
  have hβ := mem_Ico_of_caseQ (Or.inl rfl : (2⁻¹ : ℝ) = 2⁻¹ ∨ (2⁻¹ : ℝ) = β₀)
  rw [BX_eq_max w₁ t ⟨by linarith [ht.1], ht.2⟩]
  exact max_eq_right ((lemma_5_9 2⁻¹ ⟨hβ.1, hβ.2.le⟩).2 t ht)

/-- $R\le\sqrt A$ if $R\le0$ or $R^2\le A$ (and $A\ge0$). -/
theorem le_sqrt_of_sq {A R : ℝ} (h : R ≤ 0 ∨ R ^ 2 ≤ A) : R ≤ √A := by
  rcases le_total R 0 with hR | hR
  · exact hR.trans (sqrt_nonneg _)
  · rcases h with h | h
    · exact (le_antisymm h hR) ▸ sqrt_nonneg _
    · exact (Real.le_sqrt hR (le_trans (sq_nonneg R) h)).2 h

