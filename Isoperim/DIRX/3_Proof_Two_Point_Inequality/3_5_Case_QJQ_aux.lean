theorem two_Q_sub_Q_anti_x (y : ℝ) :
    AntitoneOn (fun x ↦ 2 * Q 2⁻¹ ((x + y) / 2) - Q 2⁻¹ x) (Icc 0 y) := by
  have hd : ∀ x, HasDerivAt (fun x ↦ 2 * Q 2⁻¹ ((x + y) / 2) - Q 2⁻¹ x)
