local notation "J" => JX

/-- Boolean check: the checker encloses $J_{w_1}(y)$ in $[a,b]$ (witnesses $s_l,s_u$). -/
def jw1Check (y a b sl su : ℚ) : Bool :=
  match Checker.gJwIv Checker.P0 (29 / 32) (29 / 32) y sl su with
  | some (l, u) => decide (a ≤ l ∧ u ≤ b)
  | none => false

/-- Soundness of `jw1Check`. -/
theorem gJw_w₁_mem {y a b sl su : ℚ} (h : jw1Check y a b sl su = true) :
    gJw w₁ y ∈ Icc (a : ℝ) b := by
  unfold jw1Check at h
  rcases he : Checker.gJwIv Checker.P0 (29 / 32) (29 / 32) y sl su with _ | ⟨l, u⟩ <;>
    rw [he] at h
  · cases h
  obtain ⟨h1, h2⟩ := of_decide_eq_true h
  have hm := Checker.gJwIv_sound Checker.P0 he (w := w₁) ⟨by norm_num [w₁], by norm_num [w₁]⟩
  exact ⟨(show (a : ℝ) ≤ l by exact_mod_cast h1).trans hm.1,
    hm.2.trans (show (u : ℝ) ≤ b by exact_mod_cast h2)⟩

/-- $\mathrm J(y)=J_{w_1}(y)/(2J_{w_1}(\frac12))$. -/
theorem JX_eq_div (y : ℝ) : J y = gJw w₁ y / (2 * gJw w₁ 2⁻¹) := by
  rw [JX_eq, κX_eq, div_eq_inv_mul]

/-- An enclosure of $\mathrm J(y)$ from an enclosure $[a,b]$ of $J_{w_1}(y)$, $a\ge0$. -/
theorem JX_mem_of {y : ℝ} {a b : ℝ} (ha : 0 ≤ a) (h : gJw w₁ y ∈ Icc a b) :
    J y ∈ Icc (a / (2 * 0.506997)) (b / (2 * 0.50699)) := by
  obtain ⟨g1, g2⟩ := gJw_w₁_half_fine
  rw [JX_eq_div]
  have hb : 0 ≤ b := ha.trans (h.1.trans h.2)
  have hg : (0 : ℝ) < 2 * gJw w₁ 2⁻¹ := by linarith
  exact ⟨div_le_div₀ (ha.trans h.1) h.1 hg (by linarith),
    div_le_div₀ hb h.2 (by norm_num) (by linarith)⟩

/-- $\mathrm J'(y)=\Phi^{-1}(\frac{1-y}{w_1})/(\sqrt2J_{w_1}(\frac12))$ on $(1-w_1,1)$. -/
theorem deriv_JX_eq {y : ℝ} (hy : y ∈ Ioo (1 - w₁) 1) :
    deriv J y = gInv (w₁⁻¹ * (1 - y)) / (√2 * gJw w₁ 2⁻¹) := by
  have hg : 0 < gJw w₁ 2⁻¹ := gJw_pos w₁_pos ⟨one_sub_w₁_lt_half, by norm_num⟩
  have hd : HasDerivAt J (κX * (√2 * gInv (w₁⁻¹ * (1 - y)))) y := by
    have := (hasDerivAt_gJw w₁_pos hy).const_mul κX
    exact this.congr_of_eventuallyEq (Filter.Eventually.of_forall fun t ↦ JX_eq t)
  rw [hd.deriv, κX_eq]
  have hs : 0 < √2 := by positivity
  field_simp
  rw [sq_sqrt (by norm_num)]

/-- Bounds for $\Phi^{-1}(t)$, $t\in(0,1)$, from $\Phi(-\sqrt2s_l)\le t\le\Phi(-\sqrt2s_u)$ (as
certified by `phiNegHi`, `phiNegLo`). -/
theorem gInv_mem_of_phi {t : ℝ} (ht : t ∈ Ioo 0 1) {sl su : ℚ} (hsl : 0 ≤ sl) (hsu : 0 ≤ su)
    (h1 : (Checker.phiNegHi Checker.P0 sl : ℝ) ≤ t) (h2 : t ≤ Checker.phiNegLo Checker.P0 su) :
    -(√2 * sl) ≤ gInv t ∧ gInv t ≤ -(√2 * su) := by
  constructor
  · rw [le_gInv_iff ht]; exact (Checker.gCDF_le_phiNegHi _ hsl).trans h1
  · rw [gInv_le_iff ht]; exact h2.trans (Checker.phiNegLo_le_gCDF _ hsu)

local notation "γ" => γX

/-- The derivatives of $\mathrm J$ on $(1-w_1,1)$: $\mathrm J''=-\gamma/\mathrm J$,
$\mathrm J'''=\gamma\mathrm J'/\mathrm J^2$,
$\mathrm J^{(4)}=-\gamma(\gamma+2(\mathrm J')^2)\mathrm J^{-3}$. -/
theorem derivs_JX :
    EqOn (deriv (deriv J)) (fun z ↦ -γ / J z) (Ioo (1 - w₁) 1) ∧
      EqOn (deriv (deriv (deriv J))) (fun z ↦ γ * deriv J z / J z ^ 2) (Ioo (1 - w₁) 1) ∧
      EqOn (deriv (deriv (deriv (deriv J))))
        (fun z ↦ -γ * (γ + 2 * deriv J z ^ 2) * J z ^ (-3 : ℤ)) (Ioo (1 - w₁) 1) := by
  have e2 : EqOn (deriv (deriv J)) (fun z ↦ -γ / J z) (Ioo (1 - w₁) 1) := fun z hz ↦ deriv2_JX hz
  have d3 : ∀ z ∈ Ioo (1 - w₁) 1, HasDerivAt (fun z ↦ -γ / J z) (γ * deriv J z / J z ^ 2) z :=
    fun z hz ↦ by
      have := ((JX_diff hz).1.hasDerivAt.inv (JX_pos hz).ne').const_mul (-γ)
      refine (this.congr_of_eventuallyEq (Filter.Eventually.of_forall fun w ↦ ?_)).congr_deriv ?_
      · simp only [div_eq_mul_inv, Pi.inv_apply]
      · ring
  have e3 := eqOn_deriv_of_eqOn isOpen_Ioo e2 d3
  have d4 : ∀ z ∈ Ioo (1 - w₁) 1, HasDerivAt (fun z ↦ γ * deriv J z / J z ^ 2)
      (-γ * (γ + 2 * deriv J z ^ 2) * J z ^ (-3 : ℤ)) z := fun z hz ↦ by
    have hp := (JX_pos hz).ne'
    have := (((JX_diff hz).2.hasDerivAt.const_mul γ).div ((JX_diff hz).1.hasDerivAt.pow 2)
      (pow_ne_zero 2 hp))
    refine this.congr_deriv ?_
    rw [deriv2_JX hz]
    simp only [zpow_neg, zpow_ofNat, Pi.pow_apply]
    field_simp
    ring
  exact ⟨e2, e3, eqOn_deriv_of_eqOn isOpen_Ioo e3 d4⟩

/-- The function $f(y)=G_{LJQ}(0,y)=y+(\sqrt2-1)\mathrm J(y)+L(0)-2Q(\frac y2)$ of [DIRX], §3.3,
explicitly, and its derivatives on $(1-w_1,1)$. -/
theorem derivs_fl :
    EqOn (deriv (fun y ↦ y - 0 + (√2 - 1) * J y + L 2⁻¹ 0 - 2 * Q 2⁻¹ ((0 + y) / 2)))
        (fun y ↦ 1 + (√2 - 1) * deriv J y - Q1f 2⁻¹ (y / 2)) (Ioo (1 - w₁) 1) ∧
      EqOn (deriv (deriv
        (fun y ↦ y - 0 + (√2 - 1) * J y + L 2⁻¹ 0 - 2 * Q 2⁻¹ ((0 + y) / 2))))
        (fun y ↦ -γ * (√2 - 1) * (J y)⁻¹ - 2⁻¹ * Q2f 2⁻¹ (y / 2)) (Ioo (1 - w₁) 1) ∧
      EqOn (deriv (deriv (deriv
        (fun y ↦ y - 0 + (√2 - 1) * J y + L 2⁻¹ 0 - 2 * Q 2⁻¹ ((0 + y) / 2)))))
        (fun y ↦ γ * (√2 - 1) * deriv J y / J y ^ 2 + 4 * (3 - 2 ^ (1 + (2⁻¹ : ℝ))))
        (Ioo (1 - w₁) 1) ∧
      EqOn (deriv (deriv (deriv (deriv
        (fun y ↦ y - 0 + (√2 - 1) * J y + L 2⁻¹ 0 - 2 * Q 2⁻¹ ((0 + y) / 2))))))
        (fun y ↦ (√2 - 1) * (-γ * (γ + 2 * deriv J y ^ 2) * J y ^ (-3 : ℤ))) (Ioo (1 - w₁) 1) := by
  obtain ⟨-, -, -⟩ := derivs_JX
  have d1 : ∀ y ∈ Ioo (1 - w₁) 1, HasDerivAt
      (fun y ↦ y - 0 + (√2 - 1) * J y + L 2⁻¹ 0 - 2 * Q 2⁻¹ ((0 + y) / 2))
      (1 + (√2 - 1) * deriv J y - Q1f 2⁻¹ (y / 2)) y := fun y hy ↦ by
    have hq := (hasDerivAt_Q 2⁻¹ ((0 + y) / 2)).comp y
      (((hasDerivAt_id' y).const_add 0).div_const 2)
    have := (((((hasDerivAt_id' y).sub_const 0).add
      ((JX_diff hy).1.hasDerivAt.const_mul (√2 - 1))).add_const (L 2⁻¹ 0)).sub (hq.const_mul 2))
    refine this.congr_deriv ?_
    ring_nf
  have e1 := eqOn_deriv_of_eqOn isOpen_Ioo (fun _ _ ↦ rfl) d1
  have d2 : ∀ y ∈ Ioo (1 - w₁) 1, HasDerivAt (fun y ↦ 1 + (√2 - 1) * deriv J y - Q1f 2⁻¹ (y / 2))
      (-γ * (√2 - 1) * (J y)⁻¹ - 2⁻¹ * Q2f 2⁻¹ (y / 2)) y := fun y hy ↦ by
    have hq := (hasDerivAt_Q1f 2⁻¹ (y / 2)).comp y ((hasDerivAt_id' y).div_const 2)
    have := ((JX_diff hy).2.hasDerivAt.const_mul (√2 - 1)).const_add 1 |>.sub hq
    refine this.congr_deriv ?_
    rw [deriv2_JX hy]; field_simp
  have e2 := eqOn_deriv_of_eqOn isOpen_Ioo e1 d2
  have d3 : ∀ y ∈ Ioo (1 - w₁) 1, HasDerivAt
      (fun y ↦ -γ * (√2 - 1) * (J y)⁻¹ - 2⁻¹ * Q2f 2⁻¹ (y / 2))
      (γ * (√2 - 1) * deriv J y / J y ^ 2 + 4 * (3 - 2 ^ (1 + (2⁻¹ : ℝ)))) y := fun y hy ↦ by
    have hq := (hasDerivAt_Q2f 2⁻¹ (y / 2)).comp y ((hasDerivAt_id' y).div_const 2)
    have := (((JX_diff hy).1.hasDerivAt.inv (JX_pos hy).ne').const_mul (-γ * (√2 - 1))).sub
      (hq.const_mul 2⁻¹)
    refine this.congr_deriv ?_
    field_simp; ring
  have e3 := eqOn_deriv_of_eqOn isOpen_Ioo e2 d3
  have d4 : ∀ y ∈ Ioo (1 - w₁) 1, HasDerivAt
      (fun y ↦ γ * (√2 - 1) * deriv J y / J y ^ 2 + 4 * (3 - 2 ^ (1 + (2⁻¹ : ℝ))))
      ((√2 - 1) * (-γ * (γ + 2 * deriv J y ^ 2) * J y ^ (-3 : ℤ))) y := fun y hy ↦ by
    have hp := (JX_pos hy).ne'
    have := ((((JX_diff hy).2.hasDerivAt.const_mul (γ * (√2 - 1))).div
      ((JX_diff hy).1.hasDerivAt.pow 2) (pow_ne_zero 2 hp)).add_const
        (4 * (3 - 2 ^ (1 + (2⁻¹ : ℝ)))))
    refine this.congr_deriv ?_
    rw [deriv2_JX hy]
    simp only [zpow_neg, zpow_ofNat, Pi.pow_apply]
    field_simp
    ring
  exact ⟨e1, e2, e3, eqOn_deriv_of_eqOn isOpen_Ioo e3 d4⟩

/-- If $\varphi$ is concave on $S$, $p<a<b$ in $S$, $\varphi(p)>0$ and $\varphi(b)\ge0$, then
$\varphi(a)>0$. -/
theorem concaveOn_pos_of_pos {φ : ℝ → ℝ} {S : Set ℝ} {p a b : ℝ} (hφ : ConcaveOn ℝ S φ)
    (hp : p ∈ S) (hb : b ∈ S) (hpa : p < a) (hab : a < b) (h1 : 0 < φ p) (h2 : 0 ≤ φ b) :
    0 < φ a := by
  have hbp : 0 < b - p := by linarith
  set θ := (b - a) / (b - p) with hθ
  have hθ0 : 0 < θ := div_pos (by linarith) hbp
  have hθ1 : 0 ≤ 1 - θ := by
    rw [show 1 - θ = (a - p) / (b - p) by rw [hθ]; field_simp; ring]
    exact div_nonneg (by linarith) hbp.le
  have hc : θ • p + (1 - θ) • b = a := by simp only [smul_eq_mul, hθ]; field_simp; ring
  have h := hφ.2 hp hb hθ0.le hθ1 (by ring)
  rw [hc] at h
  simp only [smul_eq_mul] at h
  nlinarith [mul_pos hθ0 h1, mul_nonneg hθ1 h2]

