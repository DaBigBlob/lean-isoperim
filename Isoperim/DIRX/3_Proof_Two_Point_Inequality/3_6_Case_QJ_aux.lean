/-! ### Enclosures of $\mathrm J$ and $|\mathrm J'|$ -/

/-- $x_1=\frac{35}{64}$. -/
theorem x₁_eq : x₁ = 35 / 64 := by norm_num [x₁, w₁]

/-- $[\frac14,1]\subseteq[1-w_1,1]$ and $(\frac14,1)\subseteq(1-w_1,1)$. -/
theorem quarter_mem {t : ℝ} (ht : t ∈ Icc (4⁻¹ : ℝ) 1) : t ∈ Icc (1 - w₁) 1 :=
  ⟨by norm_num [w₁] at ht ⊢; linarith [ht.1], ht.2⟩

/-- $\mathrm J$ is concave on $[\frac14,1]$ ($\mathrm J''<0$). -/
theorem JX_concaveOn_quarter : ConcaveOn ℝ (Icc 4⁻¹ 1) J := by
  have hsub : ∀ t ∈ Ioo (4⁻¹ : ℝ) 1, t ∈ Ioo (1 - w₁) 1 := fun t ht ↦
    ⟨by norm_num [w₁] at ht ⊢; linarith [ht.1], ht.2⟩
  refine concaveOn_of_deriv2_nonpos (convex_Icc _ _)
    (JX_contDiff.2.mono fun t ht ↦ quarter_mem ht) (fun t ht ↦ ?_) (fun t ht ↦ ?_) fun t ht ↦ ?_ <;>
    rw [interior_Icc] at ht
  · exact (JX_diff (hsub t ht)).1.differentiableWithinAt
  · exact (JX_diff (hsub t ht)).2.differentiableWithinAt
  · exact (deriv_JX.2.1 t (hsub t ht)).le

/-- $\mathrm J\ge0$ on $[\frac14,1]$. -/
theorem JX_nonneg_quarter {t : ℝ} (ht : t ∈ Icc (4⁻¹ : ℝ) 1) : 0 ≤ J t := by
  rcases eq_or_lt_of_le ht.2 with h | h
  · rw [h]; exact JX_concave.2 1 ⟨by norm_num, le_rfl⟩
  · exact (JX_pos ⟨by norm_num [w₁]; linarith [ht.1], h⟩).le

/-- $\mathrm J$ is monotone on $[\frac14,x_1]$. -/
theorem JX_monotoneOn_quarter : MonotoneOn J (Icc 4⁻¹ x₁) := by
  have hx := x₁_eq
  refine monotoneOn_of_deriv_nonneg (convex_Icc _ _)
    (JX_contDiff.2.mono fun t ht ↦ quarter_mem ⟨ht.1, by rw [hx] at ht; linarith [ht.2]⟩)
    (fun t ht ↦ ?_) fun t ht ↦ ?_ <;> rw [interior_Icc] at ht
  · exact (JX_diff ⟨by norm_num [w₁] at ht ⊢; linarith [ht.1], by rw [hx] at ht; linarith [ht.2]⟩
      ).1.differentiableWithinAt
  · exact deriv_JX_nonneg ⟨by norm_num [w₁] at ht ⊢; linarith [ht.1], ht.2.le⟩

/-- The point where the upper enclosure $\overline{\mathrm J}(m_l,m_u)$ is evaluated:
$m_u$ if $m_u<x_1$, $m_l$ if $m_l>x_1$, $x_1=\frac{35}{64}$ otherwise. -/
noncomputable def JhpR (ml mu : ℝ) : ℝ :=
  if mu < 35 / 64 then mu else if 35 / 64 < ml then ml else 35 / 64

/-- `JhpR` for rational arguments (computable, for the certificates). -/
def Jhp (ml mu : ℚ) : ℚ := if mu < 35 / 64 then mu else if 35 / 64 < ml then ml else 35 / 64

/-- `Jhp` is `JhpR` on rationals. -/
theorem Jhp_cast (ml mu : ℚ) : ((Jhp ml mu : ℚ) : ℝ) = JhpR ml mu := by
  have e1 : ((mu : ℝ) < 35 / 64) ↔ mu < 35 / 64 := by
    rw [← Rat.cast_lt (K := ℝ)]; push_cast; rfl
  have e2 : ((35 / 64 : ℝ) < ml) ↔ 35 / 64 < ml := by
    rw [← Rat.cast_lt (K := ℝ)]; push_cast; rfl
  by_cases h1 : mu < 35 / 64 <;> by_cases h2 : 35 / 64 < ml <;>
    simp [Jhp, JhpR, h1, h2, e1, e2]

/-- $\overline{\mathrm J}(m_l,m_u)=\mathrm J(\mathrm{JhpR}(m_l,m_u))$ is an upper bound of
$\mathrm J$ on $[m_l,m_u]\subseteq[\frac14,1]$. -/
theorem JX_le_JhpR {ml mu : ℝ} (hl : 4⁻¹ ≤ ml) (hu : mu ≤ 1) {m : ℝ} (hm : m ∈ Icc ml mu) :
    J m ≤ J (JhpR ml mu) := by
  have hx := x₁_eq
  obtain ⟨hmo, han⟩ := JX_mono
  unfold JhpR
  split_ifs with h1 h2
  · exact JX_monotoneOn_quarter ⟨by linarith [hm.1], by rw [hx]; linarith [hm.2]⟩
      ⟨by linarith [hm.1, hm.2], by rw [hx]; linarith⟩ hm.2
  · exact han ⟨by rw [hx]; linarith, by linarith [hm.1, hm.2]⟩
      ⟨by rw [hx]; linarith [hm.1], by linarith [hm.2]⟩ hm.1
  · rw [← hx]
    rcases le_total m x₁ with h | h
    · exact JX_monotoneOn_quarter ⟨by linarith [hm.1], h⟩ ⟨by rw [hx]; norm_num, le_rfl⟩ h
    · exact han ⟨le_rfl, by rw [hx]; norm_num⟩ ⟨h, by linarith [hm.2]⟩ h

/-- $\overline{|\mathrm J'|}(m_l,m_u)=\max(|\mathrm J'(m_l)|,|\mathrm J'(m_u)|)$ bounds $|\mathrm J'|$
on $[m_l,m_u]\subseteq(1-w_1,1)$ ($\mathrm J'$ is decreasing). -/
theorem abs_deriv_JX_le {ml mu m : ℝ} (hl : 1 - w₁ < ml) (hu : mu < 1) (hm : m ∈ Icc ml mu) :
    |deriv J m| ≤ max (|deriv J ml|) (|deriv J mu|) := by
  have hanti := deriv_JX.2.2.antitoneOn
  have h1 := hanti ⟨hl, by linarith [hm.1, hm.2]⟩ ⟨by linarith [hm.1], by linarith [hm.2]⟩ hm.1
  have h2 := hanti ⟨by linarith [hm.1], by linarith [hm.2]⟩ ⟨by linarith [hm.1, hm.2], hu⟩ hm.2
  rw [abs_le]
  constructor
  · linarith [le_max_right |deriv J ml| |deriv J mu|, neg_abs_le (deriv J mu)]
  · linarith [le_max_left |deriv J ml| |deriv J mu|, le_abs_self (deriv J ml)]

/-! ### The tight lower bound of (3.13) -/

/-- The tight lower bound $\underline{h_{QJ,1}}$ ([DIRX], §3.6.1) of
$-\frac12\partial_xg_{QJ}=y-x+(2\mathrm J(m)-Q(x))(\mathrm J'(m)-Q'(x))$, $m=\frac{x+y}2$, with
$m_l=\frac{x_l+y_l}2$, $m_u=\frac{x_u+y_u}2$, $\overline{\mathrm J}=\mathrm J(c_p)$, and $b$ the
indicator of $m_u<x_1$. -/
noncomputable def hQJ1lo (xl xu yl yu cp : ℝ) (b : Bool) : ℝ :=
  yl - xu + (if b then (2 * min (J ((xl + yl) / 2)) (J ((xu + yu) / 2)) - Q 2⁻¹ xu) *
      deriv J ((xu + yu) / 2)
    else -((2 * J cp - Q 2⁻¹ xl) * max (abs (deriv J ((xl + yl) / 2))) (abs (deriv J ((xu + yu) / 2))))) -
    (2 * J cp - Q 2⁻¹ xl) * deriv (Q 2⁻¹) xl

/-- Lower bound property of `hQJ1lo` on $[\frac14,\frac12]\times[\frac12,\frac58]$. -/
theorem hQJ1lo_le {xl xu yl yu cp x y : ℝ} {b : Bool} (hxl : 4⁻¹ ≤ xl) (hxu : xu ≤ 2⁻¹)
    (hyl : 2⁻¹ ≤ yl) (hyu : yu ≤ 5 / 8) (hb : b = true → (xu + yu) / 2 ≤ x₁)
    (hp : ∀ m ∈ Icc ((xl + yl) / 2) ((xu + yu) / 2), J m ≤ J cp)
    (hJ38 : 4⁻¹ ≤ J (3 / 8)) (hJ916 : 4⁻¹ ≤ J (9 / 16))
    (hx : x ∈ Icc xl xu) (hy : y ∈ Icc yl yu) :
    hQJ1lo xl xu yl yu cp b ≤
      y - x + (2 * J ((x + y) / 2) - Q 2⁻¹ x) * (deriv J ((x + y) / 2) - deriv (Q 2⁻¹) x) := by
  obtain ⟨hx1, hx2⟩ := hx
  obtain ⟨hy1, hy2⟩ := hy
  have hw : (1 - w₁ : ℝ) = 3 / 32 := by norm_num [w₁]
  set m := (x + y) / 2 with hm
  have hmI : m ∈ Icc ((xl + yl) / 2) ((xu + yu) / 2) := ⟨by linarith, by linarith⟩
  -- $\underline B\le B=2\mathrm J(m)-Q(x)\le\overline B$, $B\ge0$
  have hJlo := JX_concaveOn_quarter.min_le_of_mem_Icc
    (⟨by linarith, by linarith⟩ : (xl + yl) / 2 ∈ Icc (4⁻¹ : ℝ) 1)
    (⟨by linarith, by linarith⟩ : (xu + yu) / 2 ∈ Icc (4⁻¹ : ℝ) 1) hmI
  have hJhi := hp m hmI
  have hQm := Q_half_monotoneOn (⟨by linarith, by linarith⟩ : xl ∈ Icc (0 : ℝ) (65 / 128))
    (⟨by linarith, by linarith⟩ : x ∈ Icc (0 : ℝ) (65 / 128)) hx1
  have hQm' := Q_half_monotoneOn (⟨by linarith, by linarith⟩ : x ∈ Icc (0 : ℝ) (65 / 128))
    (⟨by linarith, by linarith⟩ : xu ∈ Icc (0 : ℝ) (65 / 128)) hx2
  have hQh : Q 2⁻¹ x ≤ 2⁻¹ := by
    have := Q_half_monotoneOn (⟨by linarith, by linarith⟩ : x ∈ Icc (0 : ℝ) (65 / 128))
      (⟨by norm_num, by norm_num⟩ : (2⁻¹ : ℝ) ∈ Icc (0 : ℝ) (65 / 128)) (by linarith)
    rwa [Q_half_values.2.2] at this
  have hB0 : 0 ≤ 2 * J m - Q 2⁻¹ x := by
    have := JX_concaveOn_quarter.min_le_of_mem_Icc
      (⟨by norm_num, by norm_num⟩ : (3 / 8 : ℝ) ∈ Icc (4⁻¹ : ℝ) 1)
      (⟨by norm_num, by norm_num⟩ : (9 / 16 : ℝ) ∈ Icc (4⁻¹ : ℝ) 1)
      (⟨by linarith, by linarith⟩ : m ∈ Icc (3 / 8 : ℝ) (9 / 16))
    have : (4⁻¹ : ℝ) ≤ min (J (3 / 8)) (J (9 / 16)) := le_min hJ38 hJ916
    linarith
  -- $0\le Q'(x)\le Q'(x_l)$
  have hQ1 := deriv_Q_half_nonneg (⟨by linarith, by linarith⟩ : x ∈ Icc (0 : ℝ) (65 / 128))
  have hQ2 := deriv_Q_half_anti (by linarith : (0 : ℝ) ≤ xl) hx1
  have t3 : (2 * J m - Q 2⁻¹ x) * deriv (Q 2⁻¹) x ≤ (2 * J cp - Q 2⁻¹ xl) * deriv (Q 2⁻¹) xl :=
    mul_le_mul (by linarith) hQ2 hQ1 (by linarith)
  -- the term with $\mathrm J'(m)$
  have hmU : ∀ t ∈ Icc ((xl + yl) / 2) ((xu + yu) / 2), t ∈ Ioo (1 - w₁) 1 := fun t ht ↦
    ⟨by rw [hw]; linarith [ht.1], by linarith [ht.2]⟩
  have t1 : (if b then (2 * min (J ((xl + yl) / 2)) (J ((xu + yu) / 2)) - Q 2⁻¹ xu) *
      deriv J ((xu + yu) / 2)
    else -((2 * J cp - Q 2⁻¹ xl) * max (abs (deriv J ((xl + yl) / 2))) (abs (deriv J ((xu + yu) / 2))))) ≤
      (2 * J m - Q 2⁻¹ x) * deriv J m := by
    split_ifs with hb'
    · have hmu := hb hb'
      have hd0 : 0 ≤ deriv J ((xu + yu) / 2) :=
        deriv_JX_nonneg ⟨(hmU _ (right_mem_Icc.2 (by linarith))).1, hmu⟩
      have hd1 : deriv J ((xu + yu) / 2) ≤ deriv J m :=
        deriv_JX.2.2.antitoneOn (hmU m hmI) (hmU _ (right_mem_Icc.2 (by linarith))) hmI.2
      calc (2 * min (J ((xl + yl) / 2)) (J ((xu + yu) / 2)) - Q 2⁻¹ xu) * deriv J ((xu + yu) / 2)
          ≤ (2 * J m - Q 2⁻¹ x) * deriv J ((xu + yu) / 2) :=
            mul_le_mul_of_nonneg_right (by linarith) hd0
        _ ≤ (2 * J m - Q 2⁻¹ x) * deriv J m := mul_le_mul_of_nonneg_left hd1 hB0
    · have ha := abs_deriv_JX_le (hmU _ (left_mem_Icc.2 (by linarith))).1
        (hmU _ (right_mem_Icc.2 (by linarith))).2 hmI
      have := mul_le_mul (by linarith : 2 * J m - Q 2⁻¹ x ≤ 2 * J cp - Q 2⁻¹ xl) ha
        (abs_nonneg _) (by linarith)
      have := neg_abs_le (deriv J m)
      nlinarith [mul_le_mul_of_nonneg_left this hB0]
  rw [hQJ1lo]
  nlinarith

/-! ### The tight lower bound of (3.14) -/

/-- The tight lower bound $\underline{h_{QJ,2}}$ ([DIRX], §3.6.2) of $h_{QJ,2}$, with
$\overline{\mathrm J}(\frac{x_l+y_l}2,\frac{x_u+y_u}2)=\mathrm J(c_p)$. -/
noncomputable def hQJ2lo (xl xu yl yu cp : ℝ) : ℝ :=
  √((yl - xu) ^ 2 + J yu ^ 2) + Q 2⁻¹ xl - 2 * J cp

/-- Lower bound property of `hQJ2lo` on $[\frac14,\frac12]\times[\frac58,1]$. -/
theorem hQJ2lo_le {xl xu yl yu cp x y : ℝ} (hxl : 4⁻¹ ≤ xl) (hxu : xu ≤ 2⁻¹)
    (hyl : 5 / 8 ≤ yl) (hyu : yu ≤ 1)
    (hp : ∀ m ∈ Icc ((xl + yl) / 2) ((xu + yu) / 2), J m ≤ J cp)
    (hx : x ∈ Icc xl xu) (hy : y ∈ Icc yl yu) :
    hQJ2lo xl xu yl yu cp ≤ √((y - x) ^ 2 + J y ^ 2) + Q 2⁻¹ x - 2 * J ((x + y) / 2) := by
  obtain ⟨hx1, hx2⟩ := hx
  obtain ⟨hy1, hy2⟩ := hy
  have hx := x₁_eq
  have h1 : (yl - xu) ^ 2 ≤ (y - x) ^ 2 := pow_le_pow_left₀ (by linarith) (by linarith) 2
  have hJ0 : 0 ≤ J yu := JX_concave.2 _ ⟨by linarith, hyu⟩
  have hJy : J yu ≤ J y := JX_mono.2 ⟨by rw [hx]; linarith, by linarith⟩
    ⟨by rw [hx]; linarith, hyu⟩ hy2
  have h2 : J yu ^ 2 ≤ J y ^ 2 := pow_le_pow_left₀ hJ0 hJy 2
  have hs := Real.sqrt_le_sqrt (show (yl - xu) ^ 2 + J yu ^ 2 ≤ (y - x) ^ 2 + J y ^ 2 by linarith)
  have hQ := Q_half_monotoneOn (⟨by linarith, by linarith⟩ : xl ∈ Icc (0 : ℝ) (65 / 128))
    (⟨by linarith, by linarith⟩ : x ∈ Icc (0 : ℝ) (65 / 128)) hx1
  have hp' := hp ((x + y) / 2) ⟨by linarith, by linarith⟩
  rw [hQJ2lo]
  linarith

/-- $R<\sqrt A$ if $A-\max(R,0)^2>0$. -/
theorem lt_sqrt_of_sub_max {A R : ℝ} (h : 0 < A - max R 0 ^ 2) : R < √A := by
  rcases le_total R 0 with hR | hR
  · rw [max_eq_right hR] at h
    exact hR.trans_lt (Real.sqrt_pos.2 (by linarith))
  · rw [max_eq_left hR] at h
    exact (Real.lt_sqrt hR).2 (by linarith)

